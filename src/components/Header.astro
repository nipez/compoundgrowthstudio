---
import {fetchDocument, pageIds, type Link, type SiteSettings} from '../lib/sanity';

const defaults = {
  brandName: 'Compound Growth Studio',
  brandMark: 'CG',
  navItems: [
    {label: 'Services', href: '/services/'},
    {label: 'GLP-1 + Peptide', href: '/glp-1-peptide-marketing/'},
    {label: 'Growth System', href: '/system/'},
    {label: 'Get Started', href: '/pricing/'},
    {label: 'Leadership', href: '/leadership/'},
    {label: 'FAQ', href: '/faq/'},
  ] satisfies Link[],
  navCtaLabel: 'Find Your Growth Gaps',
  navCtaHref: '/contact/',
};

const settings = await fetchDocument<SiteSettings>(pageIds.settings);
const navItems = settings?.navItems?.length ? settings.navItems : defaults.navItems;
---

<nav style="position: sticky; top: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 16px 48px; background: rgba(244,247,251,.88); backdrop-filter: blur(14px); border-bottom: 1px solid rgba(10,29,56,.09);">
  <a href="/" style="display: flex; align-items: center; gap: 12px; color: #0A1D38;">
    <span style="display: grid; place-items: center; width: 36px; height: 36px; background: #0A1D38; color: #7FB0FF; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 14px; letter-spacing: -.4px;">{settings?.brandMark ?? defaults.brandMark}</span>
    <span style="font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; font-size: 16.5px; letter-spacing: -.4px;">{settings?.brandName ?? defaults.brandName}</span>
  </a>
  <div style="display: flex; align-items: center; gap: 4px; font-size: 14.5px; font-weight: 500;">
    {navItems.map((item, index) => (
      <a class={`cgs-h${index}`} href={item.href} style="display: inline-block; padding: 10px 14px; color: #0A1D38; border-radius: 4px; white-space: nowrap; transition: background .18s, color .18s;">{item.label}</a>
    ))}
    <a class="cgs-h6" href={settings?.navCtaHref ?? defaults.navCtaHref} style="display: inline-block; margin-left: 14px; padding: 11px 20px; background: #1A4FD0; color: #FFFFFF; font-weight: 600; border-radius: 4px; white-space: nowrap; transition: background .2s, transform .2s;">{settings?.navCtaLabel ?? defaults.navCtaLabel}</a>
  </div>
</nav>
