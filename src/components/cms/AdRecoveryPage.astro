---
import {preventWidow} from '../../lib/copy';

const price = '$2,500';
---

<div>
  <header style="background: #0A1D38; color: #F4F7FB; position: relative; overflow: hidden;">
    <div style="position: absolute; inset: 0; background-image: linear-gradient(rgba(127,176,255,.07) 1px, transparent 1px), linear-gradient(90deg, rgba(127,176,255,.07) 1px, transparent 1px); background-size: 56px 56px;"></div>
    <div class="cgs-pad" style="position: relative; max-width: 1280px; margin: 0 auto; padding: 84px 48px 72px;">
      <div style="font-size: 12.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #7FB0FF;">One-time fix · 2 weeks</div>
      <h1 class="cgs-display" style="margin: 18px 0 0; max-width: 820px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 50px; line-height: 1.05; letter-spacing: -2px;">{preventWidow('Ad Account Recovery for rejected clinic campaigns.')}</h1>
      <p style="margin: 22px 0 0; max-width: 620px; font-size: 17.5px; line-height: 1.6; color: rgba(244,247,251,.74);">Ads rejected, account flagged, or stuck in review? We audit the setup, rebuild copy and landing pages for prescription-ad policy, and get you clear to run — fixed scope, fixed timeline, no retainer.</p>
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 22px; margin-top: 34px;">
        <div>
          <div style="font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 40px; letter-spacing: -1.6px;">{price}</div>
          <div style="font-size: 13.5px; color: rgba(244,247,251,.6);">Fixed price · delivered in 2 weeks</div>
        </div>
        <a href="/contact/?from=ad-account-recovery" style="display: inline-block; padding: 16px 26px; background: #1A4FD0; color: #FFFFFF; font-weight: 700; border-radius: 3px;">Start recovery</a>
      </div>
    </div>
  </header>

  <section class="cgs-pad" style="max-width: 1280px; margin: 0 auto; padding: 72px 48px;">
    <div style="max-width: 880px;">
    <h2 style="margin: 0 0 24px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 30px; color: #0A1D38;">What’s included</h2>
    <div style="display: grid; gap: 14px;">
      {[
        'Full audit of ad account, creative, and landing-page rejection points',
        'Compliant rebuild of primary campaign copy + landing page structure',
        'Prescription-advertising policy checklist your team can reuse',
        'Two-week fixed delivery window — no open-ended retainer',
        'Hand-off notes so your media buyer or our team can relaunch cleanly',
      ].map((item) => (
        <div style="display: flex; gap: 12px; font-size: 16px; color: rgba(10,29,56,.78);"><span style="color: #1A4FD0; font-weight: 700;">✓</span>{item}</div>
      ))}
    </div>
    <p style="margin: 28px 0 0; font-size: 14.5px; color: rgba(10,29,56,.55);">We cannot guarantee a platform decision. We design for clearance — the single biggest reason clinic campaigns stall.</p>
    <div class="cgs-recovery-cta">
      <div class="cgs-recovery-cta__row">
        <a href="/contact/?from=ad-account-recovery" class="cgs-recovery-cta__btn">Request Ad Account Recovery</a>
        <div class="cgs-recovery-cta__price">{price}</div>
      </div>
      <div class="cgs-recovery-cta__note">Fixed price · same-week start when capacity allows</div>
    </div>
    </div>
  </section>
</div>

<style>
  .cgs-recovery-cta {
    display: inline-block;
    max-width: 100%;
    margin-top: 40px;
    padding: 26px 30px;
    background: #e7eefa;
    border-radius: 4px;
  }

  .cgs-recovery-cta__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
  }

  .cgs-recovery-cta__btn {
    display: inline-block;
    padding: 14px 22px;
    background: #1a4fd0;
    color: #ffffff;
    font-weight: 700;
    border-radius: 3px;
  }

  .cgs-recovery-cta__price {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
    font-size: 32px;
    letter-spacing: -1.2px;
    line-height: 1;
    color: #0a1d38;
  }

  .cgs-recovery-cta__note {
    margin-top: 14px;
    font-size: 14px;
    line-height: 1.45;
    color: rgba(10, 29, 56, 0.58);
  }

  @media (max-width: 560px) {
    .cgs-recovery-cta {
      display: block;
      padding: 24px 22px;
    }

    .cgs-recovery-cta__btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
