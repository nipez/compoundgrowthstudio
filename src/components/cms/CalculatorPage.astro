---
import {preventWidow} from '../../lib/copy';
import {LEAK_DEFAULTS, computeLeak, formatNumber, formatUsd} from '../../lib/retention';

const initial = computeLeak(LEAK_DEFAULTS);
---

<div>
  <header style="background: #0A1D38; color: #F4F7FB; position: relative; overflow: hidden;">
    <div style="position: absolute; inset: 0; background-image: linear-gradient(rgba(127,176,255,.07) 1px, transparent 1px), linear-gradient(90deg, rgba(127,176,255,.07) 1px, transparent 1px); background-size: 56px 56px;"></div>
    <div style="position: relative; max-width: 1280px; margin: 0 auto; padding: 72px 48px 56px;">
      <div style="font-size: 12.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #7FB0FF;">Patient Leak Calculator</div>
      <h1 style="margin: 16px 0 0; max-width: 820px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 46px; line-height: 1.08; letter-spacing: -1.8px;">{preventWidow("See what month four is costing your clinic.", 3)}</h1>
      <p style="margin: 18px 0 0; max-width: 640px; font-size: 17px; line-height: 1.6; color: rgba(244,247,251,.74);">No login. Results update as you type. Email is only for the PDF breakdown — not to see your numbers.</p>
    </div>
  </header>

  <section style="max-width: 1120px; margin: 0 auto; padding: 48px 48px 96px;">
    <div class="cgs-calc" data-cgs-calculator style="display: grid; grid-template-columns: 1fr 1fr; gap: 28px; align-items: start;">
      <form data-cgs-calc-inputs style="display: grid; gap: 16px; padding: 28px 26px; background: #FFFFFF; border: 1px solid rgba(10,29,56,.1); border-radius: 4px;">
        <div style="font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 18px; letter-spacing: -.3px; color: #0A1D38;">Your clinic numbers</div>

        <label style="display: grid; gap: 6px; font-size: 13px; font-weight: 600; color: rgba(10,29,56,.7);">
          Active patients on program
          <input name="activePatients" type="number" min="0" step="1" value={LEAK_DEFAULTS.activePatients} style="padding: 13px 14px; font-family: 'Archivo', sans-serif; font-size: 16px; color: #0A1D38; background: #F4F7FB; border: 1px solid rgba(10,29,56,.18); border-radius: 3px;" />
        </label>
        <label style="display: grid; gap: 6px; font-size: 13px; font-weight: 600; color: rgba(10,29,56,.7);">
          Avg monthly program price ($)
          <input name="monthlyPrice" type="number" min="0" step="10" value={LEAK_DEFAULTS.monthlyPrice} style="padding: 13px 14px; font-family: 'Archivo', sans-serif; font-size: 16px; color: #0A1D38; background: #F4F7FB; border: 1px solid rgba(10,29,56,.18); border-radius: 3px;" />
        </label>
        <label style="display: grid; gap: 6px; font-size: 13px; font-weight: 600; color: rgba(10,29,56,.7);">
          New patients / month
          <input name="newPatientsPerMonth" type="number" min="0" step="1" value={LEAK_DEFAULTS.newPatientsPerMonth} style="padding: 13px 14px; font-family: 'Archivo', sans-serif; font-size: 16px; color: #0A1D38; background: #F4F7FB; border: 1px solid rgba(10,29,56,.18); border-radius: 3px;" />
        </label>
        <label style="display: grid; gap: 6px; font-size: 13px; font-weight: 600; color: rgba(10,29,56,.7);">
          % still active at month 12
          <input name="retentionAt12Pct" type="number" min="0" max="100" step="1" value={Math.round(LEAK_DEFAULTS.retentionAt12 * 100)} style="padding: 13px 14px; font-family: 'Archivo', sans-serif; font-size: 16px; color: #0A1D38; background: #F4F7FB; border: 1px solid rgba(10,29,56,.18); border-radius: 3px;" />
        </label>
        <label style="display: grid; gap: 6px; font-size: 13px; font-weight: 600; color: rgba(10,29,56,.7);">
          Patient acquisition cost ($)
          <input name="patientAcquisitionCost" type="number" min="0" step="10" value={LEAK_DEFAULTS.patientAcquisitionCost} style="padding: 13px 14px; font-family: 'Archivo', sans-serif; font-size: 16px; color: #0A1D38; background: #F4F7FB; border: 1px solid rgba(10,29,56,.18); border-radius: 3px;" />
        </label>
        <label style="display: grid; gap: 6px; font-size: 13px; font-weight: 600; color: rgba(10,29,56,.7);">
          Avg months retained
          <input name="avgMonthsRetained" type="number" min="0" step="0.5" value={LEAK_DEFAULTS.avgMonthsRetained} style="padding: 13px 14px; font-family: 'Archivo', sans-serif; font-size: 16px; color: #0A1D38; background: #F4F7FB; border: 1px solid rgba(10,29,56,.18); border-radius: 3px;" />
        </label>
        <p style="margin: 0; font-size: 12.5px; line-height: 1.5; color: rgba(10,29,56,.5);">Defaults reflect common branded GLP-1 retention (~32% at 12 months) and a $400 PAC. Replace with your numbers.</p>
      </form>

      <div style="display: grid; gap: 16px;">
        <div style="padding: 28px 26px; background: #0A1D38; color: #F4F7FB; border-radius: 4px;">
          <div style="font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #7FB0FF;">What a 10-point lift is worth / year</div>
          <div data-cgs-calc-headline style="margin-top: 10px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 48px; letter-spacing: -2px; line-height: 1;">{formatUsd(initial.tenPointLiftWorth)}</div>
          <p style="margin: 12px 0 0; font-size: 14px; line-height: 1.5; color: rgba(244,247,251,.7);">Keeping <span data-cgs-calc-lift-patients>{formatNumber(initial.liftPatientsKept)}</span> more patients on program — the number most clinics underprice.</p>
        </div>

        <div style="display: grid; gap: 12px; padding: 24px; background: #F4F7FB; border: 1px solid rgba(10,29,56,.08); border-radius: 4px;">
          <div style="display: flex; justify-content: space-between; gap: 16px; font-size: 15px;">
            <span style="color: rgba(10,29,56,.65);">Patients lost / year</span>
            <strong data-cgs-calc-lost style="color: #0A1D38;">{formatNumber(initial.patientsLostPerYear)}</strong>
          </div>
          <div style="display: flex; justify-content: space-between; gap: 16px; font-size: 15px; padding-top: 12px; border-top: 1px solid rgba(10,29,56,.08);">
            <span style="color: rgba(10,29,56,.65);">Annual revenue never earned</span>
            <strong data-cgs-calc-revenue style="color: #0A1D38;">{formatUsd(initial.annualRevenueNeverEarned)}</strong>
          </div>
          <div style="display: flex; justify-content: space-between; gap: 16px; font-size: 15px; padding-top: 12px; border-top: 1px solid rgba(10,29,56,.08);">
            <span style="color: rgba(10,29,56,.65);">Annual cost to replace them</span>
            <strong data-cgs-calc-replace style="color: #0A1D38;">{formatUsd(initial.annualReplacementCost)}</strong>
          </div>
        </div>

        <div data-cgs-calc-gate style="padding: 24px; background: #FFFFFF; border: 1px solid rgba(10,29,56,.1); border-radius: 4px;">
          <div style="font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 18px; color: #0A1D38;">Email me the PDF breakdown</div>
          <p style="margin: 8px 0 16px; font-size: 14px; line-height: 1.55; color: rgba(10,29,56,.65);">Optional. We’ll send a one-page summary with your inputs and the lift math — then you can book a growth gap call.</p>
          <form data-cgs-form="calculator" style="display: grid; gap: 10px;">
            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;height:0;width:0;" />
            <input name="clinic" required placeholder="Clinic name" style="padding: 13px 14px; font-family: 'Archivo', sans-serif; font-size: 15px; color: #0A1D38; background: #F4F7FB; border: 1px solid rgba(10,29,56,.18); border-radius: 3px;" />
            <input name="city" required placeholder="City" style="padding: 13px 14px; font-family: 'Archivo', sans-serif; font-size: 15px; color: #0A1D38; background: #F4F7FB; border: 1px solid rgba(10,29,56,.18); border-radius: 3px;" />
            <input name="email" type="email" required placeholder="Work email" style="padding: 13px 14px; font-family: 'Archivo', sans-serif; font-size: 15px; color: #0A1D38; background: #F4F7FB; border: 1px solid rgba(10,29,56,.18); border-radius: 3px;" />
            <input type="hidden" name="calc_summary" data-cgs-calc-summary value="" />
            <button type="submit" style="padding: 14px 0; font-family: 'Archivo', sans-serif; font-weight: 700; font-size: 15px; color: #FFFFFF; background: #1A4FD0; border: none; border-radius: 3px; cursor: pointer;" data-cgs-label-idle="Send the PDF breakdown" data-cgs-label-done="Sent — check your inbox">Send the PDF breakdown</button>
            <div style="font-size: 12.5px; color: rgba(10,29,56,.5);"><span data-cgs-note data-cgs-note-idle="We’ll never share your clinic numbers." data-cgs-note-done="Next: book a growth gap call if you want the fix mapped.">We’ll never share your clinic numbers.</span></div>
          </form>
          <a href="/contact/?from=calculator" style="display: inline-block; margin-top: 16px; font-weight: 600; font-size: 14.5px; color: #1A4FD0;">Find the Gaps in Your Growth System →</a>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  @media (max-width: 860px) {
    .cgs-calc {
      grid-template-columns: 1fr !important;
    }
  }
</style>
