---
import {preventWidow} from '../../lib/copy';
import type {AiVoiceDoc, ClosingCta, FeatureCard} from '../../lib/sanity';

interface Props {
  doc?: AiVoiceDoc | null;
}

const {doc = {} as AiVoiceDoc} = Astro.props;

const defaults = {
  eyebrow: '24/7 AI Inbound Agent',
  headline: 'Never miss another patient inquiry.',
  headlineHighlight: 'patient inquiry.',
  subhead:
    'Our AI voice and chat receptionist answers every call and message instantly — day or night — qualifies the lead, books the consult, and drops it straight into your CRM. Here’s a live demo for a GLP-1 / peptide clinic.',
  liveBadge: 'Try it live — click “Start a call” or “Chat” below',
  embedUrl: 'https://midwest-exteriors-production.up.railway.app/receptionist/wellness?embed=1',
  iframeTitle: '24/7 AI Inbound Voice Agent demo',
  demoCaption: 'The panel on the right is a live internal CRM view that fills in during the call or chat.',
  features: [
    {
      title: 'Answers instantly, 24/7',
      body: 'Every call and chat gets picked up on the first ring — nights, weekends, and while your front desk is with a patient.',
    },
    {
      title: 'Qualifies and books',
      body: 'It asks the intake questions, screens for fit, and books the consultation directly on your calendar.',
    },
    {
      title: 'Feeds your CRM',
      body: 'Every conversation lands in your CRM with contact details, qualification notes, and next steps — no manual entry.',
    },
  ] satisfies FeatureCard[],
  closingCta: {
    title: 'Want this answering your clinic’s phone?',
    body: 'We’ll configure it around your programs, intake questions, and calendar — and connect it to your CRM.',
    ctaLabel: 'Book a Demo Call',
    ctaHref: '/contact/',
  } satisfies ClosingCta,
};

const headline = doc?.headline ?? defaults.headline;
const highlight = doc?.headlineHighlight ?? defaults.headlineHighlight;
const highlightIndex = highlight ? headline.indexOf(highlight) : -1;
// Prefer shipped subhead when CMS still contains the banned "wellness" wording.
const rawSubhead = doc?.subhead ?? defaults.subhead;
const subhead = /\bwellness\b/i.test(rawSubhead) ? defaults.subhead : rawSubhead;
const features = doc?.features?.length ? doc.features : defaults.features;
const closingCta = {...defaults.closingCta, ...(doc?.closingCta ?? {})};
const embedUrl = doc?.embedUrl ?? defaults.embedUrl;
let embedOrigin = 'https://midwest-exteriors-production.up.railway.app';
try {
  embedOrigin = new URL(embedUrl).origin;
} catch {
  // Keep the known default origin when Sanity has an invalid draft URL.
}
---

<div>
  <header style="background: #0A1D38; color: #F4F7FB; position: relative; overflow: hidden;">
    <div style="position: absolute; inset: 0; background-image: linear-gradient(rgba(127,176,255,.07) 1px, transparent 1px), linear-gradient(90deg, rgba(127,176,255,.07) 1px, transparent 1px); background-size: 56px 56px;"></div>
    <div class="cgs-pad" style="position: relative; max-width: 1280px; margin: 0 auto; padding: 84px 48px 72px;">
      <div style="font-size: 12.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #7FB0FF; animation: rise .6s both;">{doc?.eyebrow ?? defaults.eyebrow}</div>
      <h1 class="cgs-display" style="margin: 18px 0 0; max-width: 820px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 54px; line-height: 1.06; letter-spacing: -2px; text-wrap: pretty; animation: rise .7s .1s both;">
        {highlightIndex >= 0 ? (
          <>
            {headline.slice(0, highlightIndex)}
            <span style="color: #7FB0FF;">{highlight}</span>
            {headline.slice(highlightIndex + highlight.length)}
          </>
        ) : (
          headline
        )}
      </h1>
      <p style="margin: 22px 0 0; max-width: 680px; font-size: 17.5px; line-height: 1.6; color: rgba(244,247,251,.74); animation: rise .7s .2s both;">{subhead}</p>
      <div style="display: inline-flex; align-items: center; gap: 10px; margin-top: 26px; padding: 11px 18px; border: 1px solid rgba(127,176,255,.4); border-radius: 999px; color: #7FB0FF; font-size: 13px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; animation: rise .7s .3s both;"><span style="width: 8px; height: 8px; border-radius: 50%; background: #7FB0FF; box-shadow: 0 0 0 4px rgba(127,176,255,.2);"></span>{doc?.liveBadge ?? defaults.liveBadge}</div>
    </div>
  </header>
  <section class="cgs-pad" style="max-width: 1280px; margin: 0 auto; padding: 48px 48px 0;">
    <div style="background: #FFFFFF; border: 1px solid rgba(10,29,56,.11); border-radius: 8px; overflow: hidden; box-shadow: 0 24px 60px rgba(10,29,56,.12);">
      <iframe id="ai-demo" src={embedUrl} title={doc?.iframeTitle ?? defaults.iframeTitle} allow="microphone; autoplay" scrolling="no" data-ai-demo-origin={embedOrigin} style="display: block; width: 100%; height: 900px; border: 0; background: #FFFFFF;"></iframe>
    </div>
    <p style="margin: 18px 0 0; font-size: 13px; color: rgba(10,29,56,.55);">{doc?.demoCaption ?? defaults.demoCaption}</p>
  </section>
  <section class="cgs-pad" style="max-width: 1280px; margin: 0 auto; padding: 72px 48px 96px;">
    <div class="cgs-grid-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
      {features.map((feature, index) => (
        <div style="padding: 30px 28px; background: #FFFFFF; border: 1px solid rgba(10,29,56,.09); border-radius: 4px;">
          <h3 style="margin: 0 0 8px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; font-size: 19px; letter-spacing: -.4px;">{feature.title ?? defaults.features[index]?.title}</h3>
          <p style="margin: 0; font-size: 14.5px; line-height: 1.6; color: rgba(10,29,56,.66);">{feature.body ?? defaults.features[index]?.body}</p>
        </div>
      ))}
    </div>
    <div class="cgs-cta-row" style="display: flex; align-items: center; justify-content: space-between; gap: 30px; margin-top: 26px; padding: 32px 28px; background: #0A1D38; color: #F4F7FB; border-radius: 4px;">
      <div>
        {closingCta.eyebrow && <div style="font-size: 12.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #7FB0FF; margin-bottom: 8px;">{closingCta.eyebrow}</div>}
        <h3 style="margin: 0 0 6px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 23px; letter-spacing: -.6px;">{preventWidow(closingCta.title ?? '')}</h3>
        <p style="margin: 0; font-size: 14.5px; color: rgba(244,247,251,.72);">{closingCta.body}</p>
      </div>
      <a class="cgs-h43" href={closingCta.ctaHref} style="flex-shrink: 0; padding: 14px 26px; background: #1A4FD0; color: #FFFFFF; font-weight: 700; font-size: 14.5px; border-radius: 3px; transition: background .2s;">{closingCta.ctaLabel}</a>
    </div>
  </section>
</div>


<style>
  @media (max-width: 900px) {
    .cgs-grid-3 {
      grid-template-columns: 1fr !important;
    }
    iframe,
    #ai-demo {
      max-width: 100%;
    }
  }
</style>
