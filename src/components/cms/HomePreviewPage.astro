---
/**
 * Alternate homepage design preview (WebRunner-inspired layout / type / imagery).
 * Served only at /preview/home/ — does not replace the live homepage.
 *
 * Imagery rule: team headshots appear once (team grid). Everywhere else uses
 * custom graphics, icons, diagrams, or atmospheric backgrounds.
 */

const team = [
  {name: 'Conor', role: 'Co-Founder · Brand & Demand', photo: '/images/conor.jpg'},
  {name: 'Nick', role: 'Co-Founder · Growth & Scale', photo: '/images/team-nick-v6.jpg'},
  {name: 'Tony Pardilla', role: 'Creative Partner', photo: '/images/team-tony-v13.jpg'},
  {name: 'Chris Cyril', role: 'Systems Partner', photo: '/images/team-chris-v8.jpg'},
  {name: 'Jessica Rodrigues', role: 'Client Experience', photo: '/images/team-jessica-v6.jpg'},
];

const programs = ['GLP-1 Programs', 'Medical Weight Loss', 'Peptide Therapy', 'Med Spa / Aesthetics'];

const stats = [
  {
    value: '~32%',
    title: '12-month retention',
    body: 'Typical on branded GLP-1 — most of last year’s book is already gone.',
    icon: `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 28c4-8 8-12 12-12s8 4 12 12"/><circle cx="20" cy="12" r="4"/></svg>`,
  },
  {
    value: '$300–600',
    title: 'Cost to replace one patient',
    body: 'Ads, ops, and staff time to refill a seat that used to be occupied.',
    icon: `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="7" y="12" width="26" height="18" rx="2"/><path d="M12 12V9a8 8 0 0 1 16 0v3"/><path d="M20 18v6M17 21h6"/></svg>`,
  },
  {
    value: '~$300K',
    title: 'Hole on a 100-patient book',
    body: 'At $500/mo with ~68 lost a year — plus replacement cost.',
    icon: `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 10h28M10 10v20a4 4 0 0 0 4 4h12a4 4 0 0 0 4-4V10"/><path d="M16 18h8M16 24h5"/></svg>`,
  },
  {
    value: '10 pts',
    title: 'Retention lift that pays',
    body: 'Often worth more than another year of lead-gen spend on the same book.',
    icon: `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 28l8-10 6 5 10-14"/><path d="M26 9h6v6"/></svg>`,
  },
  {
    value: '6',
    title: 'Stages. One system.',
    body: 'Visibility through optimization — not six vendors and six seams.',
    icon: `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="20" cy="20" r="12"/><circle cx="20" cy="20" r="5"/><path d="M20 8v4M20 28v4M8 20h4M28 20h4"/></svg>`,
  },
];

const ringOuter = [
  {label: 'Visibility', a: -90},
  {label: 'Education', a: -30},
  {label: 'Trust', a: 30},
  {label: 'Conversion', a: 90},
  {label: 'Retention', a: 150},
  {label: 'Optimize', a: 210},
];

const principles = [
  {
    title: 'Keep the book.',
    body: 'Acquisition without retention is a treadmill. We design for month four before we scale spend.',
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 22c5-9 9-13 10-13s5 4 10 13"/><path d="M11 22h10"/></svg>`,
  },
  {
    title: 'Write for review.',
    body: 'Compliant creative and landing pages from the first draft — not after the third rejection.',
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 6h12l4 4v16H8V6z"/><path d="M20 6v4h4M12 16h8M12 21h6"/></svg>`,
  },
  {
    title: 'Educate before you sell.',
    body: 'Cash-pay patients arrive skeptical. Authority and clarity beat hype.',
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="16" cy="12" r="5"/><path d="M6 26c2-5 6-7 10-7s8 2 10 7"/></svg>`,
  },
  {
    title: 'One system.',
    body: 'Visibility, conversion, and follow-up should share data — not live in five tools.',
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="16" r="3"/><circle cx="24" cy="10" r="3"/><circle cx="24" cy="22" r="3"/><path d="M11 16h7M21 12l-5 3M21 20l-5-3"/></svg>`,
  },
  {
    title: 'Operators stay on it.',
    body: 'Strategy and specialists don’t rotate off after onboarding.',
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 5l3 7h7l-5.5 4.5 2 7L16 19l-6.5 4.5 2-7L6 12h7l3-7z"/></svg>`,
  },
];

function polar(cx: number, cy: number, r: number, deg: number) {
  const rad = ((deg - 90) * Math.PI) / 180;
  return {x: cx + r * Math.cos(rad), y: cy + r * Math.sin(rad)};
}
---

<div class="hpv">
  <!-- Hero: atmospheric graphic field (no headshots) -->
  <header class="hpv-hero">
    <div class="hpv-hero__field" aria-hidden="true">
      <div class="hpv-hero__grid"></div>
      <div class="hpv-hero__glow"></div>
      <svg class="hpv-hero__viz" viewBox="0 0 640 360" fill="none">
        <!-- Month 1 cluster -->
        {
          Array.from({length: 60}, (_, i) => {
            const col = i % 10;
            const row = Math.floor(i / 10);
            const x = 70 + col * 18;
            const y = 90 + row * 22;
            return <circle cx={x} cy={y} r="3.2" fill="rgba(244,247,251,.88)" />;
          })
        }
        <!-- Dissolving stream -->
        {
          Array.from({length: 48}, (_, i) => {
            const t = i / 47;
            const x = 260 + t * 220 + Math.sin(i * 1.7) * 10;
            const y = 150 + Math.sin(i * 0.9) * 40 * (1 - t * 0.3);
            const o = 0.75 * (1 - t * 0.7);
            return <circle cx={x} cy={y} r={2.4 - t} fill={`rgba(255,120,72,${o.toFixed(2)})`} />;
          })
        }
        <!-- Month 12 remnant -->
        {
          Array.from({length: 18}, (_, i) => {
            const col = i % 4;
            const row = Math.floor(i / 4);
            const x = 520 + col * 16;
            const y = 130 + row * 20;
            return <circle cx={x} cy={y} r="3" fill="rgba(127,176,255,.9)" />;
          })
        }
        <text x="70" y="72" fill="rgba(127,176,255,.85)" font-size="13" font-family="Archivo,sans-serif" letter-spacing="2">MONTH 1</text>
        <text x="520" y="112" fill="rgba(127,176,255,.85)" font-size="13" font-family="Archivo,sans-serif" letter-spacing="2">MONTH 12</text>
        <text x="300" y="300" fill="rgba(255,140,80,.95)" font-size="18" font-family="Instrument Serif,Georgia,serif">~68 patients lost</text>
      </svg>
    </div>
    <div class="hpv-hero__content">
      <p class="hpv-eyebrow hpv-eyebrow--light">Compound Growth Studio</p>
      <h1 class="hpv-display hpv-display--hero">
        Your clinic’s growth partner for <em>retention-era</em> medicine.
      </h1>
      <p class="hpv-hero__sub">
        Compliant acquisition. Patient education. Systems that keep the book after month four.
      </p>
      <div class="hpv-hero__actions">
        <a class="hpv-btn hpv-btn--primary" href="/calculator/">Calculate your patient leak</a>
        <a class="hpv-btn hpv-btn--ghost" href="/contact/">Find your growth gaps</a>
      </div>
    </div>
  </header>

  <!-- Story + unique retention visual -->
  <section class="hpv-section hpv-section--split">
    <div class="hpv-wrap hpv-split">
      <div class="hpv-split__copy">
        <p class="hpv-eyebrow">Trusted by operators</p>
        <h2 class="hpv-display">
          The clinic growth studio behind
          <span class="hpv-mark">retention systems</span>
          lead-gen agencies don’t sell.
        </h2>
        <p class="hpv-body">
          Branded GLP-1 programs retain about 32% of patients at 12 months. Clinics keep buying replacements at
          $300–600 a seat. We build the continuation, plateau, and win-back layer that closes the hole — then wrap
          compliant ads and local visibility around it.
        </p>
        <a class="hpv-textlink" href="/system/">See the six-stage system →</a>
      </div>
      <div class="hpv-split__media">
        <div class="hpv-media-panel">
          <picture>
            <source srcset="/images/hero-gap.webp" type="image/webp" />
            <img
              src="/images/hero-gap.png"
              alt="Month 1 to Month 12 patient retention drop-off visualization"
              width="958"
              height="864"
            />
          </picture>
          <p class="hpv-media-panel__caption">The leak most clinics underprice</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Difference + icon stats -->
  <section class="hpv-section hpv-section--center">
    <div class="hpv-wrap hpv-narrow">
      <p class="hpv-eyebrow">The Compound Growth difference</p>
      <h2 class="hpv-display">
        Lead-gen agencies stop at the form fill.
        <span class="hpv-mark">Our system doesn’t.</span>
      </h2>
    </div>
    <div class="hpv-wrap" style="margin-top: 48px;">
      <div class="hpv-stats">
        {stats.map((stat) => (
          <article class="hpv-stat">
            <div class="hpv-stat__icon" set:html={stat.icon} />
            <div class="hpv-stat__value">{stat.value}</div>
            <h3 class="hpv-stat__title">{stat.title}</h3>
            <p class="hpv-stat__body">{stat.body}</p>
          </article>
        ))}
      </div>
      <div class="hpv-stats__cta">
        <a class="hpv-btn hpv-btn--primary" href="/calculator/">Open the Patient Leak Calculator</a>
      </div>
    </div>
  </section>

  <!-- Circular growth system diagram -->
  <section class="hpv-section hpv-section--soft">
    <div class="hpv-wrap hpv-diagram-block">
      <div class="hpv-diagram-block__copy">
        <p class="hpv-eyebrow">The marketing system</p>
        <h2 class="hpv-display">Six stages that compound — not six silos that leak.</h2>
        <p class="hpv-body">
          Visibility feeds education. Education builds trust. Trust converts. Conversion without retention is just a
          more expensive treadmill.
        </p>
        <a class="hpv-textlink" href="/system/">Explore each stage →</a>
      </div>
      <div class="hpv-diagram" aria-hidden="true">
        <svg viewBox="0 0 420 420" class="hpv-ring">
          <circle cx="210" cy="210" r="168" stroke="rgba(10,29,56,.1)" stroke-width="28" fill="none" />
          <circle cx="210" cy="210" r="124" stroke="rgba(26,79,208,.14)" stroke-width="22" fill="none" />
          <circle cx="210" cy="210" r="78" stroke="rgba(127,176,255,.35)" stroke-width="16" fill="none" stroke-dasharray="6 8" />
          <circle cx="210" cy="210" r="46" fill="#0A1D38" />
          <text x="210" y="206" text-anchor="middle" fill="#7FB0FF" font-size="18" font-family="Plus Jakarta Sans,sans-serif" font-weight="800">CG</text>
          <text x="210" y="226" text-anchor="middle" fill="rgba(244,247,251,.7)" font-size="9" font-family="Archivo,sans-serif" letter-spacing="1.5">SYSTEM</text>
          {ringOuter.map((item) => {
            const p = polar(210, 210, 168, item.a);
            const t = polar(210, 210, 198, item.a);
            return (
              <>
                <circle cx={p.x} cy={p.y} r="7" fill="#1A4FD0" />
                <text
                  x={t.x}
                  y={t.y}
                  text-anchor="middle"
                  dominant-baseline="middle"
                  fill="#0A1D38"
                  font-size="12"
                  font-family="Archivo,sans-serif"
                  font-weight="600"
                >
                  {item.label}
                </text>
              </>
            );
          })}
        </svg>
      </div>
    </div>
  </section>

  <!-- Programs (text/graphic blocks, no photos) -->
  <section class="hpv-section">
    <div class="hpv-wrap">
      <div class="hpv-section__head">
        <p class="hpv-eyebrow">Who we serve</p>
        <h2 class="hpv-display">Programs built for cash-pay clinics.</h2>
      </div>
      <div class="hpv-programs">
        {programs.map((label, i) => (
          <div class="hpv-program">
            <span class="hpv-program__n">0{i + 1}</span>
            <span class="hpv-program__label">{label}</span>
          </div>
        ))}
      </div>
      <p class="hpv-body hpv-programs__note">
        Plus hormone / TRT, metabolic health, longevity, and functional lines as clinics expand — marketed as one book,
        not eight campaigns.
      </p>
    </div>
  </section>

  <!-- Team: ONLY place headshots appear -->
  <section class="hpv-section hpv-section--soft">
    <div class="hpv-wrap">
      <div class="hpv-section__head hpv-section__head--center">
        <p class="hpv-eyebrow">You’re in good hands</p>
        <h2 class="hpv-display">Meet the Compound Growth Studio team</h2>
        <p class="hpv-body hpv-body--center">Operators and specialists — not a revolving account manager.</p>
      </div>
      <div class="hpv-team">
        {team.map((person) => (
          <article class="hpv-person">
            <img class="hpv-person__photo" src={person.photo} alt={person.name} width="512" height="512" loading="lazy" />
            <h3 class="hpv-person__name">{person.name}</h3>
            <p class="hpv-person__role">{person.role}</p>
          </article>
        ))}
      </div>
      <div class="hpv-stats__cta">
        <a class="hpv-textlink" href="/leadership/">Meet the full team →</a>
      </div>
    </div>
  </section>

  <!-- Principles (icons, not photos) -->
  <section class="hpv-section hpv-section--principles">
    <div class="hpv-wrap">
      <div class="hpv-section__head hpv-section__head--center">
        <p class="hpv-eyebrow">How we work</p>
        <h2 class="hpv-display">Guiding principles for clinic growth.</h2>
      </div>
      <div class="hpv-principles">
        {principles.map((item) => (
          <article class="hpv-principle">
            <div class="hpv-principle__icon" set:html={item.icon} />
            <h3 class="hpv-principle__title">{item.title}</h3>
            <p class="hpv-principle__body">{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Proof strip without faces -->
  <section class="hpv-section">
    <div class="hpv-wrap hpv-proof">
      <div>
        <p class="hpv-eyebrow">Proven operators</p>
        <h2 class="hpv-display">Built by people who have scaled brands, teams, and revenue.</h2>
        <p class="hpv-footnote">Figures from prior operator roles — not invented case studies.</p>
      </div>
      <div class="hpv-proof__nums">
        <div>
          <div class="hpv-culture__num">$150M</div>
          <div class="hpv-culture__label">B2B revenue scaled</div>
        </div>
        <div>
          <div class="hpv-culture__num">$25M</div>
          <div class="hpv-culture__label">ARR grown from zero</div>
        </div>
        <div>
          <div class="hpv-culture__num">100+</div>
          <div class="hpv-culture__label">Clinic locations</div>
        </div>
        <div>
          <div class="hpv-culture__num">4B+</div>
          <div class="hpv-culture__label">Media impressions</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing CTA: atmospheric, no faces -->
  <section class="hpv-section hpv-section--cta">
    <div class="hpv-wrap">
      <div class="hpv-cta">
        <div class="hpv-cta__bg" aria-hidden="true">
          <div class="hpv-cta__grid"></div>
          <div class="hpv-cta__orb"></div>
          <svg class="hpv-cta__marks" viewBox="0 0 200 80" fill="none">
            <path d="M10 60 C40 20, 70 20, 100 45 S160 70, 190 25" stroke="rgba(127,176,255,.35)" stroke-width="2" stroke-dasharray="5 7" />
            <circle cx="100" cy="45" r="4" fill="#7FB0FF" />
            <circle cx="190" cy="25" r="4" fill="#FF8A4C" />
          </svg>
        </div>
        <div class="hpv-cta__content">
          <h2 class="hpv-display hpv-display--light">Ready to close the month-four leak?</h2>
          <p class="hpv-body hpv-body--light">
            Thirty minutes on your retention, consult path, and acquisition — with a written summary of the gaps we
            find.
          </p>
          <a class="hpv-btn hpv-btn--primary" href="/contact/">Book a Growth Gap Call</a>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .hpv {
    --hpv-navy: #0a1d38;
    --hpv-blue: #1a4fd0;
    --hpv-sky: #7fb0ff;
    --hpv-mist: #e7eefa;
    --hpv-paper: #f7f9fc;
    --hpv-ink: #0a1d38;
    --hpv-muted: rgba(10, 29, 56, 0.68);
    --hpv-serif: 'Instrument Serif', Georgia, 'Times New Roman', serif;
    --hpv-sans: 'Archivo', system-ui, sans-serif;
    --hpv-display: 'Instrument Serif', Georgia, serif;
    background: #fff;
    color: var(--hpv-ink);
  }

  .hpv-wrap {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--cgs-content-max, 1280px);
    margin: 0 auto;
    padding: 0 var(--cgs-pad-x, 48px);
  }

  .hpv-narrow {
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
  }

  .hpv-section {
    padding: 104px 0;
  }

  .hpv-section--soft {
    background: var(--hpv-paper);
  }

  .hpv-section--principles {
    background: #dce8f6;
  }

  .hpv-section--center {
    padding-top: 56px;
    padding-bottom: 72px;
  }

  .hpv-section--cta {
    padding-bottom: 120px;
  }

  .hpv-section__head {
    max-width: 720px;
    margin-bottom: 48px;
  }

  .hpv-section__head--center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .hpv-eyebrow {
    margin: 0 0 16px;
    font-family: var(--hpv-sans);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--hpv-blue);
  }

  .hpv-eyebrow--light {
    color: var(--hpv-sky);
  }

  .hpv-display {
    margin: 0;
    font-family: var(--hpv-display);
    font-weight: 400;
    font-size: clamp(36px, 4.2vw, 52px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--hpv-navy);
    text-wrap: balance;
  }

  .hpv-display em {
    font-style: italic;
  }

  .hpv-display--hero {
    font-size: clamp(42px, 5.4vw, 68px);
    color: #fff;
    max-width: 920px;
    margin: 0 auto;
  }

  .hpv-display--light {
    color: #f4f7fb;
  }

  .hpv-mark {
    display: inline;
    background: linear-gradient(transparent 62%, rgba(127, 176, 255, 0.42) 62%);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    padding: 0 0.08em;
  }

  .hpv-body {
    margin: 22px 0 0;
    max-width: 540px;
    font-family: var(--hpv-sans);
    font-size: 17px;
    line-height: 1.65;
    color: var(--hpv-muted);
  }

  .hpv-body--center {
    margin-left: auto;
    margin-right: auto;
    max-width: 620px;
  }

  .hpv-body--light {
    color: rgba(244, 247, 251, 0.78);
    margin-left: auto;
    margin-right: auto;
  }

  .hpv-footnote {
    margin: 18px 0 0;
    font-size: 13px;
    color: rgba(10, 29, 56, 0.48);
  }

  .hpv-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 24px;
    border-radius: 4px;
    font-family: var(--hpv-sans);
    font-weight: 700;
    font-size: 14.5px;
    letter-spacing: 0.02em;
    transition: transform 0.2s, background 0.2s, color 0.2s, border-color 0.2s;
  }

  .hpv-btn:hover {
    transform: translateY(-1px);
    color: inherit;
  }

  .hpv-btn--primary {
    background: var(--hpv-blue);
    color: #fff;
  }

  .hpv-btn--primary:hover {
    background: #163fa8;
    color: #fff;
  }

  .hpv-btn--ghost {
    background: transparent;
    color: #f4f7fb;
    border: 1.5px solid rgba(127, 176, 255, 0.55);
  }

  .hpv-btn--ghost:hover {
    background: rgba(127, 176, 255, 0.1);
    color: #fff;
  }

  .hpv-textlink {
    display: inline-block;
    margin-top: 28px;
    font-family: var(--hpv-sans);
    font-weight: 600;
    font-size: 15px;
    color: var(--hpv-blue);
    border-bottom: 1px solid rgba(26, 79, 208, 0.35);
    padding-bottom: 2px;
  }

  .hpv-textlink:hover {
    color: var(--hpv-navy);
  }

  /* Hero — graphic atmosphere */
  .hpv-hero {
    position: relative;
    min-height: min(86vh, 780px);
    display: grid;
    align-items: end;
    overflow: hidden;
    color: #fff;
    background: #0a1d38;
  }

  .hpv-hero__field {
    position: absolute;
    inset: 0;
  }

  .hpv-hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(127, 176, 255, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(127, 176, 255, 0.07) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(180deg, #000 20%, transparent 85%);
  }

  .hpv-hero__glow {
    position: absolute;
    top: -120px;
    right: -80px;
    width: 560px;
    height: 560px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(26, 79, 208, 0.4), transparent 62%);
  }

  .hpv-hero__viz {
    position: absolute;
    left: 50%;
    top: 42%;
    width: min(920px, 92vw);
    transform: translate(-50%, -52%);
    opacity: 0.55;
    pointer-events: none;
  }

  .hpv-hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 140px 48px 88px;
    max-width: 980px;
    margin: 0 auto;
    background: linear-gradient(180deg, transparent, rgba(10, 29, 56, 0.55) 28%, rgba(10, 29, 56, 0.92));
    width: 100%;
    box-sizing: border-box;
  }

  .hpv-hero__sub {
    margin: 22px auto 0;
    max-width: 560px;
    font-family: var(--hpv-sans);
    font-size: 18px;
    line-height: 1.55;
    color: rgba(244, 247, 251, 0.78);
