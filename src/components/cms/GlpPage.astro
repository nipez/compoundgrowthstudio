---
import {preventWidow} from '../../lib/copy';
import type {ClosingCta, FeatureCard, GlpDoc, NumberedBlock} from '../../lib/sanity';

interface Props {
  doc?: GlpDoc | null;
}

const {doc = {} as GlpDoc} = Astro.props;

const defaults = {
  eyebrow: 'GLP-1 + Peptide Marketing',
  headline: 'Marketing for GLP-1 and peptide programs, built to survive ad review.',
  subhead:
    'These are the hardest programs in health marketing: platform policy is strict, patients arrive skeptical and price-sensitive, and every competitor is running the same three ads. We build the education, trust, and conversion layer that makes a weight loss clinic, hormone clinic, med spa, or aesthetic practice the credible option.',
  primaryCtaLabel: 'Book a Growth Gap Call',
  primaryCtaHref: '/contact/',
  secondaryCtaLabel: 'See the six-stage system →',
  secondaryCtaHref: '/system/',
  whyEyebrow: "Why it's different",
  whyTitle: 'Three reasons these programs stall.',
  whyCards: [
    {
      title: 'Platform policy blocks the obvious ads',
      body: 'Prescription-medication language, before-and-after imagery, and outcome claims get rejected. Clinics either water everything down or keep resubmitting the same campaign.',
    },
    {
      title: 'Patients arrive skeptical',
      body: 'They have read conflicting things about compounded versus brand, side effects, and cost. Without education, interest never becomes a consultation request.',
    },
    {
      title: 'Every competitor looks identical',
      body: 'Same offer, same stock photo, same price anchor. Without provider credibility and a real point of view, the decision defaults to whoever is cheapest.',
    },
  ] satisfies FeatureCard[],
  stackEyebrow: 'What we build',
  stackTitle: 'The GLP-1 and peptide growth stack.',
  stackItems: [
    {
      number: '01',
      title: 'Program positioning',
      body: 'What your program includes, who it is for, and why it is worth more than the cheapest option in town — stated plainly.',
    },
    {
      number: '02',
      title: 'Compliant ad creative',
      body: 'Meta and Google campaigns structured around policy from the first draft, with creative that gets attention without triggering review.',
    },
    {
      number: '03',
      title: 'Eligibility-first landing pages',
      body: 'Pages that qualify patients as they read — eligibility, expectations, provider oversight, cost transparency — then route them into intake.',
    },
    {
      number: '04',
      title: 'Patient education library',
      body: 'Treatment explainers, FAQs, and comparison content that answers the real questions before someone books.',
    },
    {
      number: '05',
      title: 'Provider-led authority content',
      body: 'Your clinicians on camera and in writing, so the trust signal comes from a person rather than a brand.',
    },
    {
      number: '06',
      title: 'Nurture for the undecided',
      body: 'Email and SMS sequences for the majority who are interested but not ready — the largest missed opportunity in these programs.',
    },
    {
      number: '07',
      title: 'Aesthetic attach sequences',
      body: 'The GLP-1 patient is new to most practices and stays in treatment for 9–15 months. We build the education and nurture that carries them from weight loss into injectables, body contouring, and skin treatments — instead of letting the program end at the last refill.',
    },
  ] satisfies NumberedBlock[],
  complianceEyebrow: 'Compliance posture',
  complianceTitle: 'Written for review, not around it.',
  complianceBody:
    'Most clinic campaigns fail twice — once at platform review, and again when a patient decides whether to book. We design for both from the first draft, and your providers approve every clinical claim before it publishes.',
  compliancePoints: [
    {
      title: 'Your providers approve clinical content',
      body: 'Treatment details, eligibility, and any medical claim go through your licensed reviewers before publishing.',
    },
    {
      title: 'No outcome promises or before-and-afters',
      body: 'We build credibility through process, oversight, and education instead of results imagery that platforms reject.',
    },
    {
      title: 'Structured for prescription-ad review',
      body: 'Landing pages and creative follow platform requirements for regulated health categories from the start.',
    },
    {
      title: 'Documented and auditable',
      body: 'Every claim traces back to an approved source, so a review request never becomes a scramble.',
    },
  ] satisfies FeatureCard[],
  closingCta: {
    eyebrow: 'Next step',
    title: "Find out why your program isn't converting.",
    body: 'Thirty minutes on your visibility, consult path, and follow-up — with a written summary of the gaps we find.',
    ctaLabel: 'Book a Growth Gap Call',
    ctaHref: '/contact/',
  } satisfies ClosingCta,
};

const whyCards = doc?.whyCards?.length ? doc.whyCards : defaults.whyCards;
// Prefer shipped stack so the 07 aesthetic attach card ships without a Sanity reseed.
const stackItems = defaults.stackItems;
const subhead = defaults.subhead;
const compliancePoints = doc?.compliancePoints?.length ? doc.compliancePoints : defaults.compliancePoints;
const closingCta = {...defaults.closingCta, ...(doc?.closingCta ?? {})};
---

<div>
  <header style="background: #0A1D38; color: #F4F7FB; position: relative; overflow: hidden;">
    <div style="position: absolute; inset: 0; background-image: linear-gradient(rgba(127,176,255,.07) 1px, transparent 1px), linear-gradient(90deg, rgba(127,176,255,.07) 1px, transparent 1px); background-size: 56px 56px;"></div>
    <div style="position: absolute; top: -150px; right: -110px; width: 580px; height: 580px; border-radius: 50%; background: radial-gradient(circle, rgba(26,79,208,.34), transparent 62%);"></div>
    <div class="cgs-pad" style="position: relative; max-width: 1280px; margin: 0 auto; padding: 84px 48px 80px;">
      <div style="font-size: 12.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #7FB0FF; animation: rise .6s both;">{doc?.eyebrow ?? defaults.eyebrow}</div>
      <h1 class="cgs-display" style="margin: 18px 0 0; max-width: 900px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 52px; line-height: 1.06; letter-spacing: -2px; animation: rise .7s .1s both;">{preventWidow(doc?.headline ?? defaults.headline)}</h1>
      <p style="margin: 22px 0 0; max-width: 660px; font-size: 17.5px; line-height: 1.6; color: rgba(244,247,251,.74); animation: rise .7s .2s both;">{subhead}</p>
      <div class="cgs-cta-actions" style="display: flex; align-items: center; gap: 20px; margin-top: 34px; animation: rise .7s .3s both;">
        <a class="cgs-h40" href={doc?.primaryCtaHref ?? defaults.primaryCtaHref} style="display: inline-block; padding: 16px 26px; background: #1A4FD0; color: #FFFFFF; font-weight: 700; font-size: 15.5px; border-radius: 3px; transition: transform .2s, background .2s;">{doc?.primaryCtaLabel ?? defaults.primaryCtaLabel}</a>
        <a class="cgs-h41" href={doc?.secondaryCtaHref ?? defaults.secondaryCtaHref} style="color: #F4F7FB; font-weight: 600; font-size: 15px; border-bottom: 1px solid rgba(244,247,251,.4); padding-bottom: 3px;">{doc?.secondaryCtaLabel ?? defaults.secondaryCtaLabel}</a>
      </div>
    </div>
  </header>

  <section class="cgs-pad" style="max-width: 1280px; margin: 0 auto; padding: 92px 48px 40px;">
    <div style="max-width: 720px; margin-bottom: 44px; animation: rise .8s both; animation-timeline: view(); animation-range: entry 0% entry 60%;">
      <div style="font-size: 12.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #1A4FD0;">{doc?.whyEyebrow ?? defaults.whyEyebrow}</div>
      <h2 style="margin: 16px 0 0; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 40px; line-height: 1.08; letter-spacing: -1.5px;">{preventWidow(doc?.whyTitle ?? defaults.whyTitle)}</h2>
    </div>
    <div class="cgs-grid-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
      {whyCards.map((card, index) => (
        <div style="padding: 32px 28px; background: #FFFFFF; border: 1px solid rgba(10,29,56,.09); border-top: 3px solid #1A4FD0; border-radius: 4px; animation: rise .8s both; animation-timeline: view(); animation-range: entry 0% entry 50%;">
          <h3 style="margin: 0 0 12px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; font-size: 20px; letter-spacing: -.5px;">{card.title ?? defaults.whyCards[index]?.title}</h3>
          <p style="margin: 0; font-size: 15px; line-height: 1.62; color: rgba(10,29,56,.68);">{card.body ?? defaults.whyCards[index]?.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="cgs-pad" style="max-width: 1280px; margin: 0 auto; padding: 60px 48px 40px;">
    <div style="max-width: 720px; margin-bottom: 44px; animation: rise .8s both; animation-timeline: view(); animation-range: entry 0% entry 60%;">
      <div style="font-size: 12.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #1A4FD0;">{doc?.stackEyebrow ?? defaults.stackEyebrow}</div>
      <h2 style="margin: 16px 0 0; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 40px; line-height: 1.08; letter-spacing: -1.5px;">{preventWidow(doc?.stackTitle ?? defaults.stackTitle)}</h2>
    </div>
    <div class="cgs-stack-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: rgba(10,29,56,.11); border: 1px solid rgba(10,29,56,.11); border-radius: 4px; overflow: hidden;">
      {stackItems.map((item, index) => {
        const isLonelyLast = index === stackItems.length - 1 && stackItems.length % 3 === 1;
        return (
          <div
            class={`cgs-h${34 + index}${isLonelyLast ? ' cgs-stack-grid__wide' : ''}`}
            style={`padding: 32px 28px; background: #FFFFFF; transition: background .25s;${isLonelyLast ? ' grid-column: 1 / -1;' : ''}`}
          >
            <div style="font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; font-size: 13px; color: #1A4FD0;">{item.number ?? defaults.stackItems[index]?.number}</div>
            <h3 style="margin: 12px 0 10px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; font-size: 19px; letter-spacing: -.4px;">{item.title ?? defaults.stackItems[index]?.title}</h3>
            <p style={`margin: 0; font-size: 14.5px; line-height: 1.6; color: rgba(10,29,56,.66);${isLonelyLast ? ' max-width: 720px;' : ''}`}>{item.body ?? defaults.stackItems[index]?.body}</p>
          </div>
        );
      })}
    </div>
  </section>

  <section style="background: #0A1D38; color: #F4F7FB; position: relative; overflow: hidden; margin-top: 60px;">
    <div style="position: absolute; inset: 0; background-image: linear-gradient(rgba(127,176,255,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(127,176,255,.06) 1px, transparent 1px); background-size: 56px 56px;"></div>
    <div class="cgs-glp-compliance cgs-pad" style="position: relative; display: grid; grid-template-columns: 1fr 1.05fr; gap: 64px; align-items: center; max-width: 1280px; margin: 0 auto; padding: 92px 48px;">
      <div style="animation: rise .8s both; animation-timeline: view(); animation-range: entry 0% entry 60%;">
        <div style="font-size: 12.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #7FB0FF;">{doc?.complianceEyebrow ?? defaults.complianceEyebrow}</div>
        <h2 style="margin: 18px 0 16px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 40px; line-height: 1.08; letter-spacing: -1.5px;">{preventWidow(doc?.complianceTitle ?? defaults.complianceTitle)}</h2>
        <p style="margin: 0; max-width: 500px; font-size: 16.5px; line-height: 1.62; color: rgba(244,247,251,.74);">{doc?.complianceBody ?? defaults.complianceBody}</p>
      </div>
      <div style="display: grid; gap: 14px;">
        {compliancePoints.map((point, index) => (
          <div style="display: flex; gap: 16px; padding: 22px 24px; background: rgba(244,247,251,.06); border: 1px solid rgba(244,247,251,.14); border-radius: 4px; animation: rise .7s both; animation-timeline: view(); animation-range: entry 0% entry 50%;">
            <span style="flex-shrink: 0; color: #7FB0FF; font-weight: 700;">✓</span>
            <div>
              <div style="font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; font-size: 16.5px; letter-spacing: -.3px;">{point.title ?? defaults.compliancePoints[index]?.title}</div>
              <div style="margin-top: 6px; font-size: 14.5px; line-height: 1.6; color: rgba(244,247,251,.7);">{point.body ?? defaults.compliancePoints[index]?.body}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cgs-pad" style="max-width: 1280px; margin: 0 auto; padding: 80px 48px 100px;">
    <div class="cgs-cta-row" style="display: flex; align-items: center; justify-content: space-between; gap: 40px; padding: 32px 28px; background: #E7EEFA; border-radius: 4px;">
      <div>
        {closingCta.eyebrow && <div style="font-size: 12.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #1A4FD0;">{closingCta.eyebrow}</div>}
        <h2 style="margin: 12px 0 8px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 32px; letter-spacing: -1.2px;">{preventWidow(closingCta.title ?? '')}</h2>
        <p style="margin: 0; max-width: 620px; font-size: 15.5px; line-height: 1.6; color: rgba(10,29,56,.7);">{closingCta.body}</p>
      </div>
      <a class="cgs-h42" href={closingCta.ctaHref} style="flex-shrink: 0; display: inline-block; padding: 16px 26px; background: #1A4FD0; color: #FFFFFF; font-weight: 700; font-size: 15px; border-radius: 3px; transition: transform .2s;">{closingCta.ctaLabel}</a>
    </div>
  </section>
</div>

<style>
  @media (max-width: 900px) {
    .cgs-stack-grid {
      grid-template-columns: 1fr 1fr !important;
    }
    .cgs-stack-grid__wide {
      grid-column: 1 / -1 !important;
    }
    .cgs-glp-compliance {
      grid-template-columns: 1fr !important;
      gap: 36px !important;
    }
  }
  @media (max-width: 640px) {
    .cgs-stack-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
