---
import {preventWidow} from '../../lib/copy';
import type {
  CompareRow,
  FeatureCard,
  HomeDoc,
  NumberedBlock,
  PersonCard,
  StatCard,
} from '../../lib/sanity';

interface Props {
  doc?: HomeDoc | null;
}

const {doc = {} as HomeDoc} = Astro.props;

function initials(name = ''): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .map((part) => part[0] ?? '')
    .join('')
    .slice(0, 2)
    .toUpperCase();
}

const defaults = {
  eyebrow: 'Marketing for modern health clinics',
  headline: "The clinics that win aren't running better ads. They're running compliant ones.",
  subhead:
    'Visibility, education, trust, conversion, follow-up, and optimization — combined into one connected growth system for medically guided programs.',
  primaryCtaLabel: 'Find the Gaps in Your Growth System',
  primaryCtaHref: '/contact/',
  secondaryCtaLabel: 'See the growth system →',
  secondaryCtaHref: '/system/',
  heroStats: [
    {value: '$150M', label: 'revenue scaled for one brand'},
    {value: '100+', label: 'clinic locations grown'},
  ] satisfies StatCard[],
  heroSupport:
    'Most agencies sell you leads and walk away. We own the full path — from first click to booked, repeat patient.',
  marqueeItems: [
    'More qualified consultations',
    'Ads written to pass compliance review',
    'Local visibility patients trust',
    'Patient education that builds authority',
    'Follow-up that turns interest into bookings',
    'One connected system — not five silos',
  ],
  whyEyebrow: 'Why clinics choose us',
  whyTitle: 'Specialized strategy for high-value health programs.',
  whyBody:
    'We help modern clinics educate patients, build trust, improve visibility, strengthen provider authority, and create better follow-up systems — so growth compounds instead of stalling.',
  pillars: [
    {
      title: 'We understand the patient journey',
      body: 'Patients need education, reassurance, and trust before they ever request a consultation.',
    },
    {
      title: 'We avoid hype-driven marketing',
      body: 'Responsible messaging, provider credibility, and claims clinics can review before publishing.',
    },
    {
      title: "We don't just hand you leads",
      body: 'Lead-gen agencies dump raw contacts and disappear. We connect visibility, conversion, and follow-up into one system measured on booked consults — not lead volume.',
    },
    {
      title: 'We focus on consult-ready demand',
      body: 'Not just impressions — clearer education, stronger trust, and more qualified consultations.',
    },
  ] satisfies FeatureCard[],
  compareEyebrow: 'The difference',
  compareTitle: 'Lead-gen agencies stop at the form fill. Our system doesn’t.',
  compareWithoutLabel: 'Without Compound Growth Studio',
  compareWithLabel: 'With Compound Growth Studio',
  compareRows: [
    {
      label: 'Ad strategy',
      without: 'Guesswork, rejected health ads, and spend that never turns into consults',
      withUs: 'Compliant Meta acquisition written to clear review and reach cash-pay patients',
    },
    {
      label: 'Patient journey',
      without: 'A form fill with no education, trust, or path to the calendar',
      withUs: 'Visibility → education → trust → conversion, handed off stage to stage',
    },
    {
      label: 'Follow-up',
      without: 'Leads go cold. No-shows pile up. One-time patients never return',
      withUs: 'Nurture, routing, rebooking, refill reminders, and win-back — owned end to end',
    },
    {
      label: 'Measurement',
      without: 'You can’t tell which ad produced which booked patient',
      withUs: 'Attribution from click to consult, then reinvestment in what works',
    },
    {
      label: 'Delivery',
      without: 'Junior account managers cycling on and off your clinic',
      withUs: 'Operators plus specialists in creative, systems, and client experience',
    },
    {
      label: 'Vendors',
      without: 'Six separate projects from six vendors — and seams that drop patients',
      withUs: 'One connected growth system run as one engine',
    },
  ] satisfies CompareRow[],
  systemEyebrow: 'One connected growth system',
  systemTitle: 'Six stages. One system. Not six silos.',
  systemStages: [
    {number: '1', title: 'Visibility', body: 'Get found by patients who can actually pay.'},
    {number: '2', title: 'Education', body: 'Answer the questions that stall a $600/mo decision.'},
    {number: '3', title: 'Trust', body: 'Make your clinic the safe choice in a skeptical category.'},
    {number: '4', title: 'Conversion', body: 'Turn interest into booked consultations.'},
    {number: '5', title: 'Follow-Up', body: 'Stop losing patients between click and consult.'},
    {number: '6', title: 'Optimization', body: 'Double down on what produces qualified consults.'},
  ] satisfies NumberedBlock[],
  systemCtaLabel: 'See what we build at each stage →',
  systemCtaHref: '/system/',
  teamEyebrow: 'Your growth bench',
  teamTitle: 'Operators and specialists — not a revolving account manager.',
  teamSubhead:
    'Co-founders lead strategy. Partners stay on the work across creative, systems, and client experience — so clinics get a bench, not a handoff.',
  teamMembers: [
    {
      name: 'Conor',
      role: 'Co-Founder · Brand & Demand',
      bio: 'Helped scale B2B revenue from $20M to $150M and built a media brand to 300,000+ followers.',
      photoUrl: '/images/conor.jpg',
      photoAlt: 'Conor',
    },
    {
      name: 'Nick',
      role: 'Co-Founder · Growth & Healthcare',
      bio: 'Scaled Bitwage U.S. ARR to ~$25M and directed marketing for 100+ healthcare locations.',
      photoUrl: '/images/nick.jpg',
      photoAlt: 'Nick',
    },
    {
      name: 'Tony Pardilla',
      role: 'Creative Partner, Design & Web',
      bio: 'Turns strategy into landing pages, campaign creative, and conversion-focused digital experiences.',
    },
    {
      name: 'Chris Cyril',
      role: 'Systems & Technology Partner',
      bio: 'Connects forms, tracking, CRM workflows, automation, and reporting behind the growth engine.',
    },
    {
      name: 'Jessica Rodrigues',
      role: 'Client Experience Coordinator',
      bio: 'Keeps onboarding, scheduling, follow-ups, and asset collection from falling through the cracks.',
    },
  ] satisfies PersonCard[],
  teamCtaLabel: 'Find Your Growth Gaps',
  teamCtaHref: '/contact/',
  teamSecondaryLabel: 'Meet the full team →',
  teamSecondaryHref: '/leadership/',
  leadMagnetEyebrow: 'Free guide',
  leadMagnetTitle: "Top 10 reasons your clinic's ads are struggling on Meta.",
  leadMagnetBody:
    'The rejection triggers, targeting mistakes, and landing-page gaps we see most — and what to fix first. Straight to your inbox.',
  leadMagnetForm: {
    emailPlaceholder: 'you@yourclinic.com',
    submitLabelIdle: 'Send Me the Free Guide',
    submitLabelDone: 'Sent — check your inbox',
    noteIdle: 'Free guide + the twice-monthly newsletter. Unsubscribe anytime.',
    noteDone: 'On its way. You’re also on the newsletter — unsubscribe anytime.',
  },
  provenEyebrow: 'Proven growth experience',
  provenTitle: 'Built by operators who have scaled brands, teams, and revenue.',
  provenStats: [
    {
      value: '$150M',
      title: 'B2B Brand & Revenue Growth',
      body: 'Conor supported revenue growth from $20M to $150M through integrated strategy and demand generation.',
    },
    {
      value: '4B+',
      title: 'Audience & Media Growth',
      body: 'A global media brand built to 300,000+ followers and over 4 billion impressions across platforms.',
    },
    {
      value: '$25M ARR',
      title: 'Scaled From the Ground Up',
      body: "Nick helped scale Bitwage's U.S. ARR from essentially zero to ~$25M as VP of Growth.",
    },
    {
      value: '100+',
      title: 'Healthcare Growth Infrastructure',
      body: 'Marketing direction for a PE-backed healthcare organization with 100+ locations in multiple states.',
    },
  ] satisfies StatCard[],
};

const heroStats = doc?.heroStats?.length ? doc.heroStats : defaults.heroStats;
const marqueeItems = doc?.marqueeItems?.length ? doc.marqueeItems : defaults.marqueeItems;
const pillars = doc?.pillars?.length ? doc.pillars : defaults.pillars;
const compareRows = doc?.compareRows?.length ? doc.compareRows : defaults.compareRows;
const systemStages = doc?.systemStages?.length ? doc.systemStages : defaults.systemStages;
const teamMembers = doc?.teamMembers?.length ? doc.teamMembers : defaults.teamMembers;
const provenStats = doc?.provenStats?.length ? doc.provenStats : defaults.provenStats;
const leadMagnetForm = {...defaults.leadMagnetForm, ...(doc?.leadMagnetForm ?? {})};

const pillarIcons = [
  '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c-4-3.5-8-6.5-8-11a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 4.5-4 7.5-8 11z"></path></svg>',
  '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7l8-4z"></path></svg>',
  '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h5m6 0h5M12 4v5m0 6v5M8 8l8 8m0-8l-8 8"></path></svg>',
  '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8m0 0h-5m5 0v5"></path></svg>',
];
---

<div>
  <header style="position: relative; background: #0A1D38; color: #F4F7FB; overflow: hidden;">
    <div style="position: absolute; inset: 0; background-image: linear-gradient(rgba(127,176,255,.07) 1px, transparent 1px), linear-gradient(90deg, rgba(127,176,255,.07) 1px, transparent 1px); background-size: 56px 56px;"></div>
    <div style="position: absolute; top: -140px; right: -100px; width: 620px; height: 620px; border-radius: 50%; background: radial-gradient(circle, rgba(26,79,208,.35), transparent 62%);"></div>
    <div style="position: relative; display: grid; grid-template-columns: 1.05fr .95fr; gap: 60px; align-items: center; max-width: 1280px; margin: 0 auto; padding: 92px 48px 104px;">
      <div>
        <div style="display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px; border: 1px solid rgba(127,176,255,.4); color: #7FB0FF; font-size: 12.5px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; animation: rise .7s .05s both;">
          <span style="width: 7px; height: 7px; background: #7FB0FF; border-radius: 50%; animation: pulse 2.4s infinite;"></span>
          {doc?.eyebrow ?? defaults.eyebrow}
        </div>
        <h1 style="margin: 26px 0 0; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 54px; line-height: 1.06; letter-spacing: -2px; animation: rise .7s .15s both;">{preventWidow(doc?.headline ?? defaults.headline)}</h1>
        <p style="margin: 24px 0 0; max-width: 520px; font-size: 18px; line-height: 1.6; color: rgba(244,247,251,.74); animation: rise .7s .3s both;">{doc?.subhead ?? defaults.subhead}</p>
        <div style="display: flex; align-items: center; gap: 20px; margin-top: 36px; animation: rise .7s .45s both;">
          <a class="cgs-h27" href={doc?.primaryCtaHref ?? defaults.primaryCtaHref} style="display: inline-block; padding: 16px 26px; background: #1A4FD0; color: #FFFFFF; font-weight: 700; font-size: 15.5px; border-radius: 3px; transition: transform .2s, background .2s;">{doc?.primaryCtaLabel ?? defaults.primaryCtaLabel}</a>
          <a class="cgs-h28" href={doc?.secondaryCtaHref ?? defaults.secondaryCtaHref} style="color: #F4F7FB; font-weight: 600; font-size: 15px; border-bottom: 1px solid rgba(244,247,251,.4); padding-bottom: 3px;">{doc?.secondaryCtaLabel ?? defaults.secondaryCtaLabel}</a>
        </div>
      </div>
      <div style="position: relative; animation: fadeIn 1s .4s both;">
        <svg viewBox="0 0 560 420" style="display: block; width: 100%;">
          <defs>
            <linearGradient id="v2area" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#4C8DFF" stop-opacity=".38"></stop>
              <stop offset="1" stop-color="#4C8DFF" stop-opacity="0"></stop>
            </linearGradient>
          </defs>
          <g stroke="rgba(244,247,251,.12)" stroke-width="1">
            <line x1="20" y1="90" x2="540" y2="90"></line>
            <line x1="20" y1="180" x2="540" y2="180"></line>
            <line x1="20" y1="270" x2="540" y2="270"></line>
            <line x1="20" y1="360" x2="540" y2="360"></line>
          </g>
          <path d="M20,360 C160,354 260,336 340,290 C420,244 480,140 540,44 L540,360 Z" fill="url(#v2area)" style="animation: fadeIn 1.4s 1.4s both;"></path>
          <path d="M20,360 C160,354 260,336 340,290 C420,244 480,140 540,44" fill="none" stroke="#7FB0FF" stroke-width="3.5" stroke-linecap="round" style="stroke-dasharray: 780; stroke-dashoffset: 780; animation: draw 2.2s .6s cubic-bezier(.4,0,.2,1) both;"></path>
          <circle cx="540" cy="44" r="7" fill="#FFFFFF" style="animation: fadeIn .4s 2.6s both;"></circle>
          <circle cx="540" cy="44" r="15" fill="none" stroke="#7FB0FF" stroke-width="1.5" style="animation: pulse 2.4s 2.8s infinite both;"></circle>
        </svg>
        <div style="position: absolute; top: 3%; left: 1%; padding: 13px 17px; background: rgba(10,29,56,.9); border: 1px solid rgba(127,176,255,.45); backdrop-filter: blur(6px); animation: floaty 5s 1.5s ease-in-out infinite;">
          <div style="font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 21px; color: #7FB0FF;">{heroStats[0]?.value ?? defaults.heroStats[0].value}</div>
          <div style="font-size: 12px; color: rgba(244,247,251,.7);">{heroStats[0]?.label ?? defaults.heroStats[0].label}</div>
        </div>
        <div style="position: absolute; bottom: 17%; right: 4%; padding: 13px 17px; background: rgba(10,29,56,.9); border: 1px solid rgba(244,247,251,.22); backdrop-filter: blur(6px); animation: floaty 6s 2s ease-in-out infinite;">
          <div style="font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 21px; color: #FFFFFF;">{heroStats[1]?.value ?? defaults.heroStats[1].value}</div>
          <div style="font-size: 12px; color: rgba(244,247,251,.7);">{heroStats[1]?.label ?? defaults.heroStats[1].label}</div>
        </div>
      </div>
    </div>
  </header>

  <div style="background: #0A1D38; color: #F4F7FB; border-top: 1px solid rgba(127,176,255,.18);">
    <p style="max-width: 920px; margin: 0 auto; padding: 28px 48px; text-align: center; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 600; font-size: 18px; line-height: 1.45; letter-spacing: -.2px; color: rgba(244,247,251,.9);">
      {doc?.heroSupport ?? defaults.heroSupport}
    </p>
  </div>

  <div style="background: #E7EEFA; color: #0A1D38; overflow: hidden; padding: 14px 0; border-bottom: 1px solid rgba(10,29,56,.1);">
    <div style="display: flex; width: max-content; animation: marquee 38s linear infinite;">
      {[0, 1].map(() => (
        <div style="display: flex; gap: 46px; padding-right: 46px; white-space: nowrap; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 600; font-size: 14.5px;">
          {marqueeItems.map((item) => <span>◆ {item}</span>)}
        </div>
      ))}
    </div>
  </div>

  <section style="max-width: 1280px; margin: 0 auto; padding: 104px 48px 88px;">
    <div style="display: grid; grid-template-columns: 1fr 1.4fr; gap: 60px; align-items: end; margin-bottom: 52px;">
      <div style="animation: rise .8s both; animation-timeline: view(); animation-range: entry 0% entry 60%;">
        <div style="font-size: 12.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #1A4FD0;">{doc?.whyEyebrow ?? defaults.whyEyebrow}</div>
        <h2 style="margin: 16px 0 0; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 42px; line-height: 1.08; letter-spacing: -1.6px;">{preventWidow(doc?.whyTitle ?? defaults.whyTitle)}</h2>
      </div>
      <p style="margin: 0; font-size: 17px; line-height: 1.65; color: rgba(10,29,56,.7); animation: rise .8s both; animation-timeline: view(); animation-range: entry 0% entry 60%;">{doc?.whyBody ?? defaults.whyBody}</p>
    </div>
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;">
      {pillars.map((pillar, index) => (
        <div class={`cgs-h${17 + index}`} style="padding: 30px 26px; background: #FFFFFF; border: 1px solid rgba(10,29,56,.09); border-radius: 4px; transition: transform .25s, box-shadow .25s; animation: rise .8s both; animation-timeline: view(); animation-range: entry 0% entry 50%;">
          <div style="display: grid; place-items: center; width: 44px; height: 44px; background: #E7EEFA; color: #1A4FD0; border-radius: 3px;"><Fragment set:html={pillarIcons[index] ?? pillarIcons[0]} /></div>
          <h3 style="margin: 22px 0 10px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; font-size: 19px; letter-spacing: -.4px;">{pillar.title ?? defaults.pillars[index]?.title}</h3>
          <p style="margin: 0; font-size: 14.5px; line-height: 1.6; color: rgba(10,29,56,.66);">{pillar.body ?? defaults.pillars[index]?.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="cgs-compare" style="background: #F4F7FB; border-top: 1px solid rgba(10,29,56,.08); border-bottom: 1px solid rgba(10,29,56,.08);">
    <div style="max-width: 1120px; margin: 0 auto; padding: 96px 48px;">
      <div style="max-width: 720px; margin: 0 auto 40px; text-align: center; animation: rise .8s both; animation-timeline: view(); animation-range: entry 0% entry 60%;">
        <div style="font-size: 12.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #1A4FD0;">{doc?.compareEyebrow ?? defaults.compareEyebrow}</div>
        <h2 style="margin: 16px 0 0; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 38px; line-height: 1.12; letter-spacing: -1.4px; color: #0A1D38;">{preventWidow(doc?.compareTitle ?? defaults.compareTitle)}</h2>
      </div>
      <div class="cgs-compare__grid" style="display: grid; grid-template-columns: 1fr 1.08fr; gap: 18px; align-items: stretch; animation: rise .8s both; animation-timeline: view(); animation-range: entry 0% entry 50%;">
        <div style="padding: 28px 26px 30px; background: #FFFFFF; border: 1px solid rgba(10,29,56,.1); border-radius: 4px;">
          <div style="margin-bottom: 22px; font-size: 13px; font-weight: 700; letter-spacing: .04em; color: rgba(10,29,56,.55);">{doc?.compareWithoutLabel ?? defaults.compareWithoutLabel}</div>
          <div style="display: grid; gap: 0;">
            {compareRows.map((row, index) => (
              <div style={`padding: ${index === 0 ? '0' : '18px'} 0 ${index === compareRows.length - 1 ? '0' : '18px'}; border-top: ${index === 0 ? 'none' : '1px solid rgba(10,29,56,.08)'};`}>
                <div style="font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: rgba(10,29,56,.42);">{row.label ?? defaults.compareRows[index]?.label}</div>
                <p style="margin: 8px 0 0; font-size: 15px; line-height: 1.5; color: rgba(10,29,56,.68);">{row.without ?? defaults.compareRows[index]?.without}</p>
              </div>
            ))}
          </div>
        </div>
        <div style="padding: 28px 26px 30px; background: #0A1D38; color: #F4F7FB; border-radius: 4px; box-shadow: 0 18px 40px rgba(10,29,56,.18);">
          <div style="margin-bottom: 22px; font-size: 13px; font-weight: 700; letter-spacing: .04em; color: #7FB0FF;">{doc?.compareWithLabel ?? defaults.compareWithLabel}</div>
          <div style="display: grid; gap: 0;">
            {compareRows.map((row, index) => (
              <div style={`padding: ${index === 0 ? '0' : '18px'} 0 ${index === compareRows.length - 1 ? '0' : '18px'}; border-top: ${index === 0 ? 'none' : '1px solid rgba(244,247,251,.12)'};`}>
                <div style="font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: rgba(127,176,255,.75);">{row.label ?? defaults.compareRows[index]?.label}</div>
                <div style="display: flex; gap: 12px; margin-top: 8px; align-items: flex-start;">
                  <span style="flex-shrink: 0; display: grid; place-items: center; width: 20px; height: 20px; margin-top: 1px; border-radius: 50%; background: #1A4FD0; color: #FFFFFF; font-size: 11px; font-weight: 700;" aria-hidden="true">✓</span>
                  <p style="margin: 0; font-size: 15px; line-height: 1.5; color: rgba(244,247,251,.9);">{row.withUs ?? defaults.compareRows[index]?.withUs}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section style="background: #0A1D38; color: #F4F7FB; position: relative; overflow: hidden;">
    <div style="position: absolute; inset: 0; background-image: linear-gradient(rgba(127,176,255,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(127,176,255,.06) 1px, transparent 1px); background-size: 56px 56px;"></div>
    <div style="position: relative; max-width: 1280px; margin: 0 auto; padding: 100px 48px;">
      <div style="text-align: center; max-width: 720px; margin: 0 auto 60px; animation: rise .8s both; animation-timeline: view(); animation-range: entry 0% entry 60%;">
        <div style="font-size: 12.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #7FB0FF;">{doc?.systemEyebrow ?? defaults.systemEyebrow}</div>
        <h2 style="margin: 18px 0 0; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 42px; letter-spacing: -1.6px;">{preventWidow(doc?.systemTitle ?? defaults.systemTitle)}</h2>
      </div>
      <div style="position: relative;">
        <svg viewBox="0 0 1184 8" preserveAspectRatio="none" style="position: absolute; top: 33px; left: 0; width: 100%; height: 8px;">
          <line x1="0" y1="4" x2="1184" y2="4" stroke="rgba(127,176,255,.55)" stroke-width="2" stroke-dasharray="8 6" style="animation: flow 1.2s linear infinite;"></line>
        </svg>
        <div style="position: relative; display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px;">
          {systemStages.map((stage, index) => (
            <div style="text-align: center; animation: rise .8s both; animation-timeline: view(); animation-range: entry 0% entry 50%;">
              <div class={`cgs-h${21 + index}`} style="display: grid; place-items: center; width: 66px; height: 66px; margin: 0 auto; background: #0A1D38; border: 2px solid #7FB0FF; color: #7FB0FF; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 21px; border-radius: 50%; transition: transform .25s, background .25s, color .25s;">{stage.number ?? defaults.systemStages[index]?.number}</div>
              <h3 style="margin: 18px 0 8px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; font-size: 17px; letter-spacing: -.3px;">{stage.title ?? defaults.systemStages[index]?.title}</h3>
              <p style="margin: 0; font-size: 13.5px; line-height: 1.55; color: rgba(244,247,251,.64);">{stage.body ?? defaults.systemStages[index]?.body}</p>
            </div>
          ))}
        </div>
      </div>
      <div style="text-align: center; margin-top: 56px;">
        <a class="cgs-h29" href={doc?.systemCtaHref ?? defaults.systemCtaHref} style="display: inline-block; padding: 15px 26px; border: 1.5px solid rgba(127,176,255,.6); color: #7FB0FF; font-weight: 600; font-size: 15px; border-radius: 3px; transition: background .2s, color .2s;">{doc?.systemCtaLabel ?? defaults.systemCtaLabel}</a>
      </div>
    </div>
  </section>

  <section class="cgs-team" style="max-width: 1280px; margin: 0 auto; padding: 100px 48px 20px;">
    <div style="max-width: 760px; margin: 0 auto 48px; text-align: center; animation: rise .8s both; animation-timeline: view(); animation-range: entry 0% entry 60%;">
      <div style="font-size: 12.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #1A4FD0;">{doc?.teamEyebrow ?? defaults.teamEyebrow}</div>
      <h2 style="margin: 16px 0 0; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 38px; line-height: 1.12; letter-spacing: -1.4px; color: #0A1D38;">{preventWidow(doc?.teamTitle ?? defaults.teamTitle)}</h2>
      <p style="margin: 18px 0 0; font-size: 16.5px; line-height: 1.6; color: rgba(10,29,56,.68);">{doc?.teamSubhead ?? defaults.teamSubhead}</p>
    </div>
    <div class="cgs-team__grid" style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 18px;">
      {teamMembers.map((member, index) => {
        const fallback = defaults.teamMembers[index];
        const name = member.name ?? fallback?.name ?? '';
        const photoUrl = member.photoUrl ?? fallback?.photoUrl;
        const photoAlt = member.photoAlt ?? name;
        return (
          <div style="text-align: center; padding: 8px 6px 4px; animation: rise .8s both; animation-timeline: view(); animation-range: entry 0% entry 50%;">
            {photoUrl ? (
              <img src={photoUrl} alt={photoAlt} style="display: block; width: 112px; height: 112px; margin: 0 auto; border-radius: 50%; object-fit: cover; border: 3px solid #E7EEFA;" />
            ) : (
              <div style="display: grid; place-items: center; width: 112px; height: 112px; margin: 0 auto; border-radius: 50%; background: #0A1D38; color: #7FB0FF; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 28px; letter-spacing: -.5px; border: 3px solid #E7EEFA;" aria-hidden="true">{initials(name)}</div>
            )}
            <h3 style="margin: 18px 0 0; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 18px; letter-spacing: -.4px; color: #0A1D38;">{name}</h3>
            <div style="margin: 6px 0 10px; font-size: 11.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #1A4FD0;">{member.role ?? fallback?.role}</div>
            <p style="margin: 0; font-size: 13.5px; line-height: 1.55; color: rgba(10,29,56,.66);">{member.bio ?? fallback?.bio}</p>
          </div>
        );
      })}
    </div>
    <div style="display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 18px 24px; margin-top: 44px;">
      <a class="cgs-h27" href={doc?.teamCtaHref ?? defaults.teamCtaHref} style="display: inline-block; padding: 15px 26px; background: #1A4FD0; color: #FFFFFF; font-weight: 700; font-size: 15px; border-radius: 3px; transition: transform .2s, background .2s;">{doc?.teamCtaLabel ?? defaults.teamCtaLabel}</a>
      <a class="cgs-h28" href={doc?.teamSecondaryHref ?? defaults.teamSecondaryHref} style="color: #0A1D38; font-weight: 600; font-size: 15px; border-bottom: 1px solid rgba(10,29,56,.28); padding-bottom: 3px;">{doc?.teamSecondaryLabel ?? defaults.teamSecondaryLabel}</a>
    </div>
  </section>

  <section style="max-width: 1280px; margin: 0 auto; padding: 96px 48px 0;">
    <div style="display: grid; grid-template-columns: 1.15fr 1fr; gap: 48px; align-items: center; padding: 48px 44px; background: #E7EEFA; border: 1px solid rgba(26,79,208,.18); border-radius: 4px; animation: rise .8s both; animation-timeline: view(); animation-range: entry 0% entry 60%;">
      <div>
        <div style="font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #1A4FD0;">{doc?.leadMagnetEyebrow ?? defaults.leadMagnetEyebrow}</div>
        <h2 style="margin: 14px 0 10px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 32px; letter-spacing: -1.2px;">{preventWidow(doc?.leadMagnetTitle ?? defaults.leadMagnetTitle)}</h2>
        <p style="margin: 0; font-size: 15.5px; line-height: 1.62; color: rgba(10,29,56,.72);">{doc?.leadMagnetBody ?? defaults.leadMagnetBody}</p>
      </div>
      <form data-cgs-form="lead_magnet" style="display: grid; gap: 12px;">
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;height:0;width:0;" />
        <input name="email" class="cgs-f1" type="email" required placeholder={leadMagnetForm.emailPlaceholder} style="padding: 15px 16px; font-family: 'Archivo', sans-serif; font-size: 15px; color: #0A1D38; background: #FFFFFF; border: 1px solid rgba(10,29,56,.2); border-radius: 3px; outline: none;" />
        <button class="cgs-h30" type="submit" style="padding: 15px 0; font-family: 'Archivo', sans-serif; font-weight: 700; font-size: 15px; color: #FFFFFF; background: #1A4FD0; border: none; border-radius: 3px; cursor: pointer; transition: background .2s;" data-cgs-label-idle={leadMagnetForm.submitLabelIdle} data-cgs-label-done={leadMagnetForm.submitLabelDone}>{leadMagnetForm.submitLabelIdle}</button>
        <div style="font-size: 12.5px; color: rgba(10,29,56,.55);"><span data-cgs-note data-cgs-note-idle={leadMagnetForm.noteIdle} data-cgs-note-done={leadMagnetForm.noteDone}>{leadMagnetForm.noteIdle}</span></div>
      </form>
    </div>
  </section>

  <section style="max-width: 1280px; margin: 0 auto; padding: 104px 48px;">
    <div style="max-width: 760px; margin-bottom: 56px; animation: rise .8s both; animation-timeline: view(); animation-range: entry 0% entry 60%;">
      <div style="font-size: 12.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #1A4FD0;">{doc?.provenEyebrow ?? defaults.provenEyebrow}</div>
      <h2 style="margin: 16px 0 0; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 42px; letter-spacing: -1.6px;">{preventWidow(doc?.provenTitle ?? defaults.provenTitle)}</h2>
    </div>
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;">
      {provenStats.map((stat, index) => (
        <div style="padding: 32px 28px; background: #FFFFFF; border: 1px solid rgba(10,29,56,.09); border-top: 3px solid #1A4FD0; border-radius: 4px; animation: rise .8s both; animation-timeline: view(); animation-range: entry 0% entry 50%;">
          <div style="font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 38px; letter-spacing: -1.6px; color: #0A1D38;">{stat.value ?? defaults.provenStats[index]?.value}</div>
          <h3 style="margin: 14px 0 8px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; font-size: 16.5px; letter-spacing: -.2px;">{stat.title ?? defaults.provenStats[index]?.title}</h3>
          <p style="margin: 0; font-size: 14px; line-height: 1.6; color: rgba(10,29,56,.66);">{stat.body ?? defaults.provenStats[index]?.body}</p>
        </div>
      ))}
    </div>
  </section>
</div>

<style>
  @media (max-width: 980px) {
    .cgs-compare__grid {
      grid-template-columns: 1fr !important;
    }
    .cgs-team__grid {
      grid-template-columns: repeat(3, 1fr) !important;
    }
  }
  @media (max-width: 720px) {
    .cgs-team__grid {
      grid-template-columns: 1fr 1fr !important;
    }
  }
</style>
