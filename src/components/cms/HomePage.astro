    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Two-path diagram replacing the old comparison table. */
  .cgs-paths {
    display: grid;
    gap: 18px;
    margin: 0;
    animation: rise 0.8s both;
    animation-timeline: view();
    animation-range: entry 0% entry 50%;
  }

  .cgs-path {
    padding: 26px 28px 28px;
    border-radius: 4px;
  }

  .cgs-path--them {
    background: #ffffff;
    border: 1px solid rgba(10, 29, 56, 0.12);
  }

  .cgs-path--us {
    background: #0a1d38;
    color: #f4f7fb;
    box-shadow: 0 18px 40px rgba(10, 29, 56, 0.18);
  }

  .cgs-path__label {
    margin-bottom: 24px;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    color: rgba(10, 29, 56, 0.55);
  }

  .cgs-path--us .cgs-path__label {
    color: #7fb0ff;
  }

  .cgs-path__flow {
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
    width: 100%;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cgs-path--them .cgs-path__flow,
  .cgs-path--us .cgs-path__flow {
    justify-content: center;
  }

  .cgs-path__step {
    display: flex;
    align-items: center;
    flex: 1 1 0;
    min-width: 0;
  }

  .cgs-path__pill,
  .cgs-path__dead {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 auto;
    width: 100%;
    gap: 10px;
    padding: 16px 18px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.2px;
    text-align: center;
    white-space: normal;
    line-height: 1.25;
    border-radius: 999px;
  }

  /* Connector line drawn between pills, not inside them. */
  .cgs-path__step + .cgs-path__step::before {
    content: '';
    flex-shrink: 0;
    width: 18px;
    height: 2px;
    margin: 0 8px;
    background: currentColor;
    opacity: 0.4;
  }

  .cgs-path--them .cgs-path__pill {
    background: #f4f7fb;
    border: 1px solid rgba(10, 29, 56, 0.12);
    color: rgba(10, 29, 56, 0.78);
  }

  .cgs-path__dead {
    color: #b42318;
    padding-left: 12px;
    background: transparent;
  }

  .cgs-path__step--dead::before {
    background: repeating-linear-gradient(90deg, #b42318 0 6px, transparent 6px 12px) !important;
    opacity: 0.75 !important;
  }

  .cgs-path__x {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    background: rgba(180, 35, 24, 0.12);
    border-radius: 50%;
    font-size: 13px;
  }

  .cgs-path--us .cgs-path__pill {
    background: rgba(127, 176, 255, 0.12);
    border: 1px solid rgba(127, 176, 255, 0.32);
    color: #f4f7fb;
  }

  .cgs-path--us .cgs-path__step:last-child .cgs-path__pill {
    background: #1a4fd0;
    border-color: #1a4fd0;
  }

  .cgs-path__loop {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px dashed rgba(127, 176, 255, 0.35);
    font-size: 14.5px;
    color: rgba(244, 247, 251, 0.72);
  }

  .cgs-path__loop-icon {
    color: #7fb0ff;
    font-size: 17px;
  }

  /* Stack the flow vertically on small screens so connectors never orphan. */
  @media (max-width: 900px) {
    .cgs-path__flow {
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px 0;
    }

    .cgs-path__step {
      flex: 1 1 calc(50% - 20px);
    }
  }

  @media (max-width: 760px) {
    .cgs-path__label {
      font-size: 13px;
    }

    .cgs-path__flow {
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      gap: 0;
    }

    .cgs-path--them .cgs-path__flow,
    .cgs-path--us .cgs-path__flow {
      align-items: stretch;
    }

    .cgs-path__step {
      flex: 1 1 auto;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }

    .cgs-path--them .cgs-path__step,
    .cgs-path--us .cgs-path__step {
      align-items: stretch;
    }

    .cgs-path--them .cgs-path__step + .cgs-path__step::before,
    .cgs-path--us .cgs-path__step + .cgs-path__step::before {
      margin-left: 0;
    }

    .cgs-path__pill,
    .cgs-path__dead {
      font-size: 15px;
      padding: 14px 18px;
    }

    .cgs-path__step + .cgs-path__step::before {
      width: 2px;
      height: 14px;
      margin: 4px auto;
    }

    .cgs-path__step--dead::before {
      background: repeating-linear-gradient(180deg, #b42318 0 4px, transparent 4px 8px) !important;
    }
  }

