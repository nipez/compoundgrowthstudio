---
import {preventWidow} from '../../lib/copy';
---

<div>
  <header style="background: #0A1D38; color: #F4F7FB; position: relative; overflow: hidden;">
    <div style="position: absolute; inset: 0; background-image: linear-gradient(rgba(127,176,255,.07) 1px, transparent 1px), linear-gradient(90deg, rgba(127,176,255,.07) 1px, transparent 1px); background-size: 56px 56px;"></div>
    <div class="cgs-pad" style="position: relative; max-width: 1280px; margin: 0 auto; padding: 84px 48px 72px;">
      <div style="font-size: 12.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #7FB0FF;">Local SEO for GLP-1 clinics</div>
      <h1 class="cgs-display" style="margin: 18px 0 0; max-width: 860px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 48px; line-height: 1.06; letter-spacing: -1.8px;">{preventWidow('Patients search the drug name. Hims and Ro cannot own your city.', 4)}</h1>
      <p style="margin: 22px 0 0; max-width: 640px; font-size: 17.5px; line-height: 1.6; color: rgba(244,247,251,.74);">National telehealth brands win paid attention. They are structurally weak in local search and Google Business Profile — the channel where cash-pay patients look for a clinic they can drive to.</p>
      <div style="display: flex; flex-wrap: wrap; gap: 18px; margin-top: 32px;">
        <a href="/contact/" style="display: inline-block; padding: 15px 24px; background: #1A4FD0; color: #FFFFFF; font-weight: 700; border-radius: 3px;">Find Your Growth Gaps</a>
        <a href="/services/" style="color: #F4F7FB; font-weight: 600; border-bottom: 1px solid rgba(244,247,251,.35); padding-bottom: 2px; align-self: center;">See visibility services →</a>
      </div>
    </div>
  </header>

  <section class="cgs-pad" style="max-width: 1280px; margin: 0 auto; padding: 72px 48px;">
    <div style="max-width: 880px;">
    <h2 style="margin: 0; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 32px; letter-spacing: -1.2px; color: #0A1D38;">The anti-Hims angle</h2>
    <p style="margin: 18px 0 0; font-size: 16.5px; line-height: 1.7; color: rgba(10,29,56,.72);">Patients rarely type “best weight loss clinic near me” first. They search semaglutide, tirzepatide, Wegovy, Zepbound, and compound-era synonyms — then look for a local, supervised option. Service pages and GBP that speak those queries beat a generic med-spa homepage every time.</p>
    <div style="display: grid; gap: 16px; margin-top: 36px;">
      {[
        {t: 'Drug-name and program service pages', b: 'Pages built around how patients actually search — eligibility, oversight, expectations — not thin location stubs.'},
        {t: 'Google Business Profile as a conversion surface', b: 'Categories, services, posts, Q&A, and review response that national brands cannot personalize city by city.'},
        {t: 'Local proof Hims cannot fake', b: 'Provider faces, clinic photos, driving directions, and city-specific trust signals that move a cash-pay decision.'},
      ].map((card) => (
        <div style="padding: 24px 26px; background: #F4F7FB; border: 1px solid rgba(10,29,56,.08); border-radius: 4px;">
          <h3 style="margin: 0 0 8px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; font-size: 19px; color: #0A1D38;">{card.t}</h3>
          <p style="margin: 0; font-size: 15px; line-height: 1.6; color: rgba(10,29,56,.68);">{card.b}</p>
        </div>
      ))}
    </div>
    </div>
  </section>

  <section style="background: #E7EEFA;">
    <div class="cgs-pad cgs-cta-row" style="max-width: 1280px; margin: 0 auto; padding: 64px 48px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 28px; align-items: center;">
      <div style="max-width: 640px;">
        <h2 style="margin: 0; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 28px; letter-spacing: -1px; color: #0A1D38;">Want local visibility mapped to retention?</h2>
        <p style="margin: 10px 0 0; font-size: 15.5px; color: rgba(10,29,56,.7);">Acquisition that feeds a leak is expensive. We connect local demand to the follow-up system.</p>
      </div>
      <a href="/calculator/" style="display: inline-block; padding: 15px 22px; background: #1A4FD0; color: #FFFFFF; font-weight: 700; border-radius: 3px; white-space: nowrap;">Calculate your patient leak →</a>
    </div>
  </section>
</div>
