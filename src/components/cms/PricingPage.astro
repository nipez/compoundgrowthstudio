---
import {preventWidow} from '../../lib/copy';
import type {PricingDoc, PricingTier} from '../../lib/sanity';

interface Props {
  doc?: PricingDoc | null;
}

const {doc = {} as PricingDoc} = Astro.props;

const defaults = {
  eyebrow: 'Get started',
  headline: 'Start small. Scale when it works.',
  subhead:
    'Two ways in — a compliant foundation, a full growth system — plus a one-time fix when your ads are stuck.',
  intro: 'One path, two entry points — most clinics start in the middle and grow up.',
  tiers: [
    {
      badge: 'Where most clinics start',
      name: 'Conversion Foundation',
      price: '$1,000',
      period: '/month',
      description:
        'A managed acquisition foundation for your primary program: compliant landing page, intake flow, and continuous optimization. No setup fee, cancel anytime.',
      features: [
        'Compliant landing page + full intake flow',
        'Written to pass prescription-ad review',
        'Ongoing updates and A/B testing monthly',
        'Conversion tracking + monthly reporting',
        'Add hormone, TRT, or longevity lines as you launch them',
        'Month-3/4 retention sequences for patients you already acquired',
        'Grows with you — add paid, SEO, or nurture',
      ],
      ctaLabel: 'Start With the Foundation',
      ctaHref: '/contact/',
      highlighted: true,
    },
    {
      name: 'Full Growth System',
      price: 'Custom',
      period: ' / retainer',
      description:
        'The complete six-stage system run as one engine — visibility, education, trust, conversion, follow-up, and optimization working together.',
      features: [
        'All six stages managed as one system',
        'Paid acquisition, local SEO, and content',
        'Provider authority + reputation systems',
        'Email/SMS nurture for the undecided',
        'Fractional growth leadership for your clinic',
      ],
      ctaLabel: 'Book a Growth Call',
      ctaHref: '/contact/',
      highlighted: false,
    },
  ] satisfies PricingTier[],
  recoveryEyebrow: 'One-time fix · Fixed timeline',
  recoveryTitle: 'Ad Account Recovery',
  recoveryBody:
    'Ads rejected, account flagged, or campaigns stuck in review? We audit your setup, rebuild the copy and landing page for compliance, and get you clear to run — in a fixed two-week window, no retainer required.',
  recoveryPriceLabel: '$2,500',
  recoveryTimeline: 'Fixed price · delivered in 2 weeks',
  recoveryCtaLabel: "See What's Included",
  recoveryCtaHref: '/ad-account-recovery/',
  footerNoteBefore: 'Not sure where to start?',
  footerNoteLinkLabel: 'Find the gaps in your growth system →',
  footerNoteLinkHref: '/contact/',
  newsletter: {
    emailPlaceholder: 'you@yourclinic.com',
    submitLabelIdle: 'Send Me the Newsletter',
    submitLabelDone: "You're in — check your inbox",
    noteIdle: 'Twice a month. Unsubscribe anytime.',
    noteDone: 'Thanks. First issue lands within two weeks.',
  },
};

const tiers = defaults.tiers;
const subhead = defaults.subhead;
const intro = defaults.intro;
const eyebrow = doc?.eyebrow ?? defaults.eyebrow;
const headline = doc?.headline ?? defaults.headline;
const newsletter = {...defaults.newsletter, ...(doc?.newsletter ?? {})};
const recoveryPriceLabel = defaults.recoveryPriceLabel;
const recoveryTimeline = defaults.recoveryTimeline;
const recoveryCtaHref = defaults.recoveryCtaHref;
---

<div>
  <header style="background: #0A1D38; color: #F4F7FB; position: relative; overflow: hidden;">
    <div style="position: absolute; inset: 0; background-image: linear-gradient(rgba(127,176,255,.07) 1px, transparent 1px), linear-gradient(90deg, rgba(127,176,255,.07) 1px, transparent 1px); background-size: 56px 56px;"></div>
    <div class="cgs-pad" style="position: relative; max-width: 1280px; margin: 0 auto; padding: 84px 48px 76px; text-align: center;">
      <div style="font-size: 12.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #7FB0FF; animation: rise .6s both;">{eyebrow}</div>
      <h1 class="cgs-display" style="margin: 18px auto 0; max-width: 780px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 52px; line-height: 1.06; letter-spacing: -2px; animation: rise .7s .1s both;">{preventWidow(headline)}</h1>
      <p style="margin: 22px auto 0; max-width: 620px; font-size: 17.5px; line-height: 1.6; color: rgba(244,247,251,.74); animation: rise .7s .2s both;">{subhead}</p>
    </div>
  </header>
  <section class="cgs-pad" style="max-width: 1280px; margin: 0 auto; padding: 56px 48px 0;">
    <p style="text-align: center; margin: 0 0 44px; font-size: 13.5px; letter-spacing: .04em; color: rgba(10,29,56,.56);">{intro}</p>
    <div class="cgs-pricing-stack">
      <div class="cgs-pricing-grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; align-items: stretch;">
      {tiers.map((tier, index) => {
        const fallback = defaults.tiers[index];
        const highlighted = Boolean(tier.highlighted);
        const features = tier.features?.length ? tier.features : fallback?.features ?? [];
        const cardStyle = highlighted
          ? 'display: flex; flex-direction: column; padding: 34px 30px; background: #0A1D38; color: #F4F7FB; border-radius: 4px; transform: translateY(-14px); box-shadow: 0 24px 50px rgba(10,29,56,.22); animation: rise .8s .1s both;'
          : `display: flex; flex-direction: column; padding: 34px 30px; background: #FFFFFF; border: 1px solid rgba(10,29,56,.13); border-radius: 4px; animation: rise .8s ${index ? `.${index}s` : ''} both;`;
        return (
          <div style={cardStyle}>
            {tier.badge && <div style="align-self: flex-start; padding: 5px 10px; margin-bottom: 14px; background: #7FB0FF; color: #0A1D38; font-size: 10.5px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;">{tier.badge}</div>}
            <div style={`font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: ${highlighted ? '#7FB0FF' : '#1A4FD0'};`}>{tier.name ?? fallback?.name}</div>
            <div style={`margin: 18px 0 0; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: ${(tier.price ?? fallback?.price) === 'Custom' ? '32px' : '40px'}; letter-spacing: -1.6px; line-height: 1.3;`}>
              {tier.price ?? fallback?.price}<span style={`font-size: 16px; font-weight: 500; letter-spacing: 0; color: ${highlighted ? 'rgba(244,247,251,.55)' : 'rgba(10,29,56,.55)'};`}>{tier.period ?? fallback?.period}</span>
            </div>
            <p style={`margin: 16px 0 22px; font-size: 14px; line-height: 1.55; color: ${highlighted ? 'rgba(244,247,251,.72)' : 'rgba(10,29,56,.68)'};`}>{tier.description ?? fallback?.description}</p>
            <div style="display: grid; gap: 11px; font-size: 14px; flex: 1; align-content: start;">
              {features.map((feature) => (
                <div style="display: flex; gap: 10px;"><span style={`color: ${highlighted ? '#7FB0FF' : '#1A4FD0'}; font-weight: 700;`}>✓</span>{feature}</div>
              ))}
            </div>
            <a class={`cgs-pricing-tier__cta ${highlighted ? 'cgs-h45' : 'cgs-h46'}`} href={tier.ctaHref ?? fallback?.ctaHref} style={highlighted ? 'display: block; margin-top: 26px; padding: 14px 0; text-align: center; background: #1A4FD0; color: #FFFFFF; font-weight: 700; font-size: 14.5px; border-radius: 3px; transition: transform .2s, background .2s;' : 'display: block; margin-top: 26px; padding: 14px 0; text-align: center; border: 1.5px solid #0A1D38; color: #0A1D38; font-weight: 600; font-size: 14.5px; border-radius: 3px; transition: background .2s, color .2s;'}>{tier.ctaLabel ?? fallback?.ctaLabel}</a>
          </div>
        );
      })}
      </div>
      <div class="cgs-pricing-recovery">
        <div class="cgs-pricing-recovery__grid" aria-hidden="true"></div>
        <div class="cgs-pricing-recovery__copy">
          <div class="cgs-pricing-recovery__eyebrow">{doc?.recoveryEyebrow ?? defaults.recoveryEyebrow}</div>
          <h3 class="cgs-pricing-recovery__title">{doc?.recoveryTitle ?? defaults.recoveryTitle}</h3>
          <p class="cgs-pricing-recovery__body">{doc?.recoveryBody ?? defaults.recoveryBody}</p>
        </div>
        <div class="cgs-pricing-recovery__aside">
          <div class="cgs-pricing-recovery__price">{recoveryPriceLabel}</div>
          <div class="cgs-pricing-recovery__timeline">{recoveryTimeline}</div>
          <a class="cgs-h47 cgs-pricing-recovery__cta" href={recoveryCtaHref}>{doc?.recoveryCtaLabel ?? defaults.recoveryCtaLabel}</a>
        </div>
      </div>
    </div>
    <p style="text-align: center; margin: 44px 0 96px; font-size: 14.5px; color: rgba(10,29,56,.62);">{doc?.footerNoteBefore ?? defaults.footerNoteBefore} <a href={doc?.footerNoteLinkHref ?? defaults.footerNoteLinkHref} style="font-weight: 600;">{doc?.footerNoteLinkLabel ?? defaults.footerNoteLinkLabel}</a></p>
  </section>

  <section id="newsletter" class="cgs-pad" style="max-width: 1280px; margin: 0 auto; padding: 0 48px 96px;">
    <div class="cgs-pricing-stack">
    <form data-cgs-form="newsletter" class="cgs-pricing-newsletter">
      <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;height:0;width:0;" />
      <input type="email" name="email" required placeholder={newsletter.emailPlaceholder} style="padding: 15px 16px; font-family: 'Archivo', sans-serif; font-size: 15px; color: #0A1D38; background: #F4F7FB; border: 1px solid rgba(10,29,56,.2); border-radius: 3px; outline: none;" class="cgs-focus-blue" />
      <button type="submit" data-cgs-label-idle={newsletter.submitLabelIdle} data-cgs-label-done={newsletter.submitLabelDone} style="padding: 15px 0; font-family: 'Archivo', sans-serif; font-weight: 700; font-size: 15px; color: #FFFFFF; background: #1A4FD0; border: none; border-radius: 3px; cursor: pointer; transition: background .2s;" class="cgs-h-navy">{newsletter.submitLabelIdle}</button>
      <div data-cgs-note data-cgs-note-idle={newsletter.noteIdle} data-cgs-note-done={newsletter.noteDone} style="font-size: 12.5px; color: rgba(10,29,56,.55);">{newsletter.noteIdle}</div>
    </form>
    </div>
  </section>
</div>

<style>
  /* Tier CTAs set color inline, which outranks the shared hover rules. */
  .cgs-pricing-tier__cta.cgs-h44:hover,
  .cgs-pricing-tier__cta.cgs-h46:hover,
  .cgs-pricing-tier__cta.cgs-h45:hover {
    color: #ffffff !important;
  }

  .cgs-pricing-stack {
    max-width: 900px;
    margin: 0 auto;
  }

  .cgs-pricing-newsletter {
    display: grid;
    gap: 12px;
    width: 100%;
    max-width: 640px;
    margin-left: auto;
    padding: 36px 32px;
    background: #ffffff;
    border: 1px solid rgba(10, 29, 56, 0.1);
    border-radius: 4px;
  }

  .cgs-pricing-recovery {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 26px;
    padding: 28px 30px;
    background: #0a1d38;
    color: #f4f7fb;
    border-radius: 4px;
    animation: rise 0.8s both;
    animation-timeline: view();
    animation-range: entry 0% entry 60%;
  }

  .cgs-pricing-recovery__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(127, 176, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(127, 176, 255, 0.06) 1px, transparent 1px);
    background-size: 56px 56px;
  }

  .cgs-pricing-recovery__copy,
  .cgs-pricing-recovery__aside {
    position: relative;
  }

  .cgs-pricing-recovery__copy {
    flex: 1 1 320px;
    min-width: 0;
  }

  .cgs-pricing-recovery__eyebrow {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #7fb0ff;
  }

  .cgs-pricing-recovery__title {
    margin: 10px 0 8px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
    font-size: 23px;
    letter-spacing: -0.6px;
  }

  .cgs-pricing-recovery__body {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: rgba(244, 247, 251, 0.72);
  }

  .cgs-pricing-recovery__aside {
    display: grid;
    flex: 0 0 auto;
    justify-items: end;
    gap: 4px;
    text-align: right;
  }

  .cgs-pricing-recovery__price {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
    font-size: 30px;
    letter-spacing: -1px;
    line-height: 1;
  }

  .cgs-pricing-recovery__timeline {
    font-size: 12.5px;
    color: rgba(244, 247, 251, 0.6);
    white-space: nowrap;
  }

  .cgs-pricing-recovery__cta {
    display: inline-block;
    margin-top: 12px;
    padding: 12px 22px;
    border: 1.5px solid rgba(244, 247, 251, 0.35);
    color: #f4f7fb;
    font-weight: 600;
    font-size: 14px;
    white-space: nowrap;
    border-radius: 3px;
    transition: border-color 0.2s;
  }

  @media (max-width: 980px) {
    .cgs-pricing-grid {
      grid-template-columns: 1fr !important;
    }
    .cgs-pricing-grid > div {
      transform: none !important;
    }
    .cgs-pricing-recovery {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      padding: 28px 24px;
    }
    .cgs-pricing-recovery__aside {
      justify-items: start;
      text-align: left;
    }
    .cgs-pricing-newsletter {
      max-width: none;
      margin-left: 0;
    }
  }
</style>
