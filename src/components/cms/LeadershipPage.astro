---
import {preventWidow} from '../../lib/copy';
import type {LeadershipDoc, PersonCard} from '../../lib/sanity';

interface Props {
  doc?: LeadershipDoc | null;
}

const {doc = {} as LeadershipDoc} = Astro.props;

const defaults = {
  eyebrow: 'Leadership',
  headline: 'Operators, not account managers.',
  subhead:
    'Experience across healthcare, SaaS, fintech, B2B, consumer, media, and multi-location growth environments — applied to modern health clinics.',
  founders: [
    {
      name: 'Conor',
      role: 'Co-Founder · Brand & Demand',
      bio: 'Supported B2B revenue growth from $20M to $150M through integrated strategy and demand generation, and built a global media brand to 300,000+ followers and 4B+ impressions.',
      photoUrl: '/images/conor.jpg',
      photoAlt: 'Conor',
    },
    {
      name: 'Nick',
      role: 'Co-Founder · Growth & Healthcare',
      bio: 'Healthcare and wellness growth executive with 20+ years building brands, launching products, and driving patient acquisition across multi-location healthcare, digital health, and consumer wellness — combining marketing leadership, performance, and AI-enabled growth systems.',
      photoUrl: '/images/nick2.jpg',
      photoAlt: 'Nick Perez',
    },
  ] satisfies PersonCard[],
  partnersTitle: 'Specialist partners',
  partnersSubhead:
    'Co-founders lead the studio. Specialist partners support client delivery across creative, systems, and client experience.',
  partners: [
    {
      name: 'Tony Pardilla',
      role: 'Creative Partner, Design & Web',
      bio: 'Tony supports creative and web execution behind the studio’s clinic growth work — turning strategy into polished landing pages, campaign creative, visual systems, and conversion-focused digital experiences.',
      helps: [
        'Website design direction',
        'Landing pages',
        'Brand identity support',
        'Campaign creative',
        'Social templates',
        'Conversion-focused design',
      ],
    },
    {
      name: 'Chris Cyril',
      role: 'Systems & Technology Partner',
      bio: 'Chris supports the systems and technology layer behind the growth engine — connecting forms, tracking, CRM workflows, automation, integrations, analytics, and reporting.',
      helps: [
        'Lead form setup',
        'CRM workflow support',
        'Tracking',
        'Automation systems',
        'Funnel infrastructure',
        'Reporting systems',
      ],
    },
    {
      name: 'Jessica Rodrigues',
      role: 'Client Experience Coordinator',
      bio: 'Jessica supports onboarding, communication, scheduling, follow-ups, asset collection, and project coordination — so clinic teams always know what is happening and what comes next.',
      photoUrl: '/images/jessica.jpg',
      photoAlt: 'Jessica Rodrigues',
      helps: ['Onboarding', 'Scheduling', 'Client communication', 'Follow-ups', 'Asset collection', 'Project coordination'],
    },
  ] satisfies PersonCard[],
  trackRecordTitle: 'Track record',
  trackRecordItems: [
    'Led growth at Capital One Shopping, increasing the user base by more than 600% in six months.',
    'Founded a digital marketing agency that was successfully acquired.',
    'Led a 25+ person global demand generation organization.',
    'Managed growth across more than a dozen SaaS products simultaneously.',
    'Generated 500 qualified leads nationally for a new service vertical.',
    'Created $1M in new recurring revenue through subscription-based programs.',
  ],
};

const founders = defaults.founders.map((fallback, index) => {
  const person = doc?.founders?.[index] ?? {};
  const isNick = (person.name ?? fallback.name ?? '').toLowerCase().startsWith('nick');
  return {
    ...fallback,
    ...person,
    photoUrl: (isNick ? fallback.photoUrl : undefined) ?? person.photoUrl ?? person.photoSrc ?? fallback.photoUrl,
    photoAlt: person.photoAlt ?? fallback.photoAlt,
    // Prefer shipped Nick copy/photo until Sanity leadership founders are re-seeded.
    bio: isNick ? (fallback.bio ?? person.bio) : (person.bio ?? fallback.bio),
    name: person.name ?? fallback.name,
    role: person.role ?? fallback.role,
  };
});
const partners = doc?.partners?.length ? doc.partners : defaults.partners;
const trackRecordItems = doc?.trackRecordItems?.length ? doc.trackRecordItems : defaults.trackRecordItems;

function initials(name = ''): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .map((part) => part[0] ?? '')
    .join('')
    .slice(0, 2)
    .toUpperCase();
}
---

<div>
  <header style="background: #0A1D38; color: #F4F7FB; position: relative; overflow: hidden;">
    <div style="position: absolute; inset: 0; background-image: linear-gradient(rgba(127,176,255,.07) 1px, transparent 1px), linear-gradient(90deg, rgba(127,176,255,.07) 1px, transparent 1px); background-size: 56px 56px;"></div>
    <div style="position: relative; max-width: 1280px; margin: 0 auto; padding: 84px 48px 76px;">
      <div style="font-size: 12.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #7FB0FF; animation: rise .6s both;">{doc?.eyebrow ?? defaults.eyebrow}</div>
      <h1 style="margin: 18px 0 0; max-width: 820px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 52px; line-height: 1.06; letter-spacing: -2px; animation: rise .7s .1s both;">{preventWidow(doc?.headline ?? defaults.headline)}</h1>
      <p style="margin: 22px 0 0; max-width: 640px; font-size: 17.5px; line-height: 1.6; color: rgba(244,247,251,.74); animation: rise .7s .2s both;">{doc?.subhead ?? defaults.subhead}</p>
    </div>
  </header>
  <section style="max-width: 1280px; margin: 0 auto; padding: 76px 48px 40px;">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
      {founders.map((founder, index) => (
        <div style={`display: flex; gap: 28px; padding: 36px; background: #FFFFFF; border: 1px solid rgba(10,29,56,.09); border-radius: 4px; animation: rise .8s ${index ? '.1s' : ''} both;`}>
          <img src={founder.photoUrl ?? defaults.founders[index]?.photoUrl} alt={founder.photoAlt ?? founder.name ?? defaults.founders[index]?.photoAlt} style="flex-shrink: 0; width: 112px; height: 112px; border-radius: 50%; object-fit: cover;" />
          <div>
            <h2 style="margin: 0; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 23px; letter-spacing: -.6px;">{founder.name ?? defaults.founders[index]?.name}</h2>
            <div style="margin: 6px 0 14px; font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: #1A4FD0;">{founder.role ?? defaults.founders[index]?.role}</div>
            <p style="margin: 0; font-size: 14.5px; line-height: 1.65; color: rgba(10,29,56,.7);">{founder.bio ?? defaults.founders[index]?.bio}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
  <section style="max-width: 1280px; margin: 0 auto; padding: 40px 48px 20px;">
    <div style="max-width: 720px; margin-bottom: 28px; animation: rise .8s both; animation-timeline: view(); animation-range: entry 0% entry 60%;">
      <h2 style="margin: 0 0 10px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 30px; letter-spacing: -1.1px;">{preventWidow(doc?.partnersTitle ?? defaults.partnersTitle)}</h2>
      <p style="margin: 0; font-size: 15.5px; line-height: 1.6; color: rgba(10,29,56,.7);">{doc?.partnersSubhead ?? defaults.partnersSubhead}</p>
    </div>
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
      {partners.map((partner, index) => {
        const fallback = defaults.partners[index];
        const helps = partner.helps?.length ? partner.helps : fallback?.helps ?? [];
        const name = partner.name ?? fallback?.name ?? '';
        const photoUrl = partner.photoUrl ?? fallback?.photoUrl;
        const photoAlt = partner.photoAlt ?? name;
        return (
          <div style="padding: 32px 30px; background: #FFFFFF; border: 1px solid rgba(10,29,56,.09); border-radius: 4px; animation: rise .8s both; animation-timeline: view(); animation-range: entry 0% entry 50%;">
            {photoUrl ? (
              <img src={photoUrl} alt={photoAlt} style="display: block; width: 88px; height: 88px; margin: 0 0 18px; border-radius: 50%; object-fit: cover; object-position: center top;" />
            ) : (
              <div style="display: grid; place-items: center; width: 88px; height: 88px; margin: 0 0 18px; border-radius: 50%; background: #0A1D38; color: #7FB0FF; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 22px;" aria-hidden="true">{initials(name)}</div>
            )}
            <h3 style="margin: 0; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 20px; letter-spacing: -.5px;">{name}</h3>
            <div style="margin: 6px 0 14px; font-size: 12.5px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: #1A4FD0;">{partner.role ?? fallback?.role}</div>
            <p style="margin: 0 0 16px; font-size: 14.5px; line-height: 1.65; color: rgba(10,29,56,.7);">{partner.bio ?? fallback?.bio}</p>
            <div style="display: flex; flex-wrap: wrap; gap: 8px 16px;">
              {helps.map((help) => (
                <div style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgba(10,29,56,.62);"><span style="flex-shrink: 0; width: 5px; height: 5px; border-radius: 50%; background: #7FB0FF;"></span>{help}</div>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>
  <section style="max-width: 1280px; margin: 0 auto; padding: 40px 48px 100px;">
    <h2 style="margin: 0 0 28px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 30px; letter-spacing: -1.1px;">{preventWidow(doc?.trackRecordTitle ?? defaults.trackRecordTitle)}</h2>
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;">
      {trackRecordItems.map((item) => (
        <div style="padding: 26px 24px; background: #FFFFFF; border: 1px solid rgba(10,29,56,.09); border-radius: 4px; font-size: 14.5px; line-height: 1.6; color: rgba(10,29,56,.78); animation: rise .8s both; animation-timeline: view(); animation-range: entry 0% entry 50%;">{item}</div>
      ))}
    </div>
  </section>
</div>
