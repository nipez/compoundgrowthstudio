---
import {fetchDocument, pageIds, type Link, type SiteSettings} from '../lib/sanity';

const defaults = {
  brandName: 'Compound Growth Studio',
  brandMark: 'CG',
  footerBlurb:
    'A boutique growth strategy and digital marketing studio for GLP-1, medical weight loss, peptide, and med spa clinics — and the hormone, metabolic, and longevity lines those clinics expand into.',
  footerLeadMagnetTitle: "Free guide: Top 10 reasons your clinic's ads are struggling on Meta",
  footerLeadMagnet: {
    emailPlaceholder: 'you@yourclinic.com',
    submitLabelIdle: 'Get the Guide',
    submitLabelDone: 'Sent ✓',
  },
  footerExploreHeading: 'Explore',
  footerExploreLinks: [
    {label: 'Services', href: '/services/'},
    {label: 'Patient Leak Calculator', href: '/calculator/'},
    {label: 'Who We Serve', href: '/glp-1-peptide-marketing/'},
    {label: 'Local SEO for GLP-1', href: '/local-seo-for-glp1-clinics/'},
    {label: 'GLP-1 Marketing Compliance', href: '/glp1-marketing-compliance/'},
    {label: 'Growth System', href: '/system/'},
    {label: 'Leadership', href: '/leadership/'},
    {label: 'FAQ', href: '/faq/'},
  ] satisfies Link[],
  footerGetStartedHeading: 'Get started',
  footerGetStartedLinks: [
    {label: 'Pricing & Community', href: '/pricing/'},
    {label: 'Ad Account Recovery', href: '/ad-account-recovery/'},
    {label: 'Book a growth call', href: '/contact/'},
  ] satisfies Link[],
  footerDisclaimer:
    "Compound Growth Studio provides marketing strategy, content, and digital growth support. Medical claims, treatment details, pricing, eligibility, prescription information, and patient-facing clinical content should be reviewed and approved by the clinic's licensed medical professionals before publishing.",
};

function remapServeLabel(item: Link): Link {
  if ((item.href ?? '').includes('glp-1-peptide-marketing')) {
    return {...item, label: 'Who We Serve'};
  }
  return item;
}

const settings = await fetchDocument<SiteSettings>(pageIds.settings);
const footerLeadMagnet = {...defaults.footerLeadMagnet, ...(settings?.footerLeadMagnet ?? {})};
// Prefer shipped blurb until Sanity footer copy is re-seeded without "wellness".
const footerBlurb = defaults.footerBlurb;
const exploreLinks = defaults.footerExploreLinks.map(remapServeLabel);
const getStartedLinks = defaults.footerGetStartedLinks;
---

<footer class="cgs-footer">
  <div class="cgs-footer__inner">
    <div class="cgs-footer__top">
      <div>
        <div class="cgs-footer__brand">
          <span class="cgs-footer__mark">{settings?.brandMark ?? defaults.brandMark}</span>
          <span class="cgs-footer__name">{settings?.brandName ?? defaults.brandName}</span>
        </div>
        <p class="cgs-footer__blurb">{footerBlurb}</p>
        <div class="cgs-footer__magnet">
          <div class="cgs-footer__magnet-title">{settings?.footerLeadMagnetTitle ?? defaults.footerLeadMagnetTitle}</div>
          <form data-cgs-form="lead_magnet" class="cgs-footer__form">
            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="cgs-footer__honeypot" />
            <input name="email" class="cgs-f0 cgs-footer__input" type="email" required placeholder={footerLeadMagnet.emailPlaceholder} />
            <button class="cgs-h7 cgs-footer__submit" type="submit" data-cgs-label-idle={footerLeadMagnet.submitLabelIdle} data-cgs-label-done={footerLeadMagnet.submitLabelDone}>{footerLeadMagnet.submitLabelIdle}</button>
          </form>
        </div>
      </div>
      <div class="cgs-footer__cols">
        <div class="cgs-footer__col">
          <div class="cgs-footer__heading">{settings?.footerExploreHeading ?? defaults.footerExploreHeading}</div>
          {exploreLinks.map((item, index) => (
            <a class={`cgs-h${8 + index}`} href={item.href}>{item.label}</a>
          ))}
        </div>
        <div class="cgs-footer__col">
          <div class="cgs-footer__heading">{settings?.footerGetStartedHeading ?? defaults.footerGetStartedHeading}</div>
          {getStartedLinks.map((item, index) => (
            <a class={`cgs-h${14 + index}`} href={item.href}>{item.label}</a>
          ))}
        </div>
      </div>
    </div>
    <p class="cgs-footer__disclaimer">{settings?.footerDisclaimer ?? defaults.footerDisclaimer}</p>
  </div>
</footer>

<style>
  .cgs-footer {
    background: #071426;
    color: rgba(244, 247, 251, 0.6);
  }

  .cgs-footer__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 60px 48px 44px;
  }

  .cgs-footer__top {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 64px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(244, 247, 251, 0.1);
  }

  .cgs-footer__brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #f4f7fb;
  }

  .cgs-footer__mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    background: #1a4fd0;
    color: #ffffff;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
    font-size: 13px;
  }

  .cgs-footer__name {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 700;
    font-size: 16px;
  }

  .cgs-footer__blurb {
    margin: 18px 0 0;
    max-width: 480px;
    font-size: 13.5px;
    line-height: 1.7;
  }

  .cgs-footer__magnet {
    margin-top: 26px;
    max-width: 480px;
  }

  .cgs-footer__magnet-title {
    font-size: 13px;
    font-weight: 600;
    color: rgba(244, 247, 251, 0.8);
  }

  .cgs-footer__form {
    display: flex;
    gap: 10px;
    margin-top: 12px;
  }

  .cgs-footer__honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    width: 0;
  }

  .cgs-footer__input {
    flex: 1;
    min-width: 0;
    padding: 12px 14px;
    font-family: 'Archivo', sans-serif;
    font-size: 14px;
    color: #f4f7fb;
    background: rgba(244, 247, 251, 0.07);
    border: 1px solid rgba(244, 247, 251, 0.2);
    border-radius: 3px;
    outline: none;
  }

  .cgs-footer__submit {
    flex-shrink: 0;
    padding: 12px 18px;
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-size: 14px;
    color: #ffffff;
    background: #1a4fd0;
    border: none;
    border-radius: 3px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .cgs-footer__cols {
    display: flex;
    gap: 56px;
    justify-content: end;
  }

  .cgs-footer__col {
    display: grid;
    gap: 11px;
    align-content: start;
    font-size: 14px;
  }

  .cgs-footer__col a {
    color: rgba(244, 247, 251, 0.75);
  }

  .cgs-footer__heading {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(244, 247, 251, 0.4);
  }

  .cgs-footer__disclaimer {
    margin: 28px 0 0;
    max-width: 900px;
    font-size: 12px;
    line-height: 1.7;
    color: rgba(244, 247, 251, 0.42);
  }

  @media (max-width: 900px) {
    .cgs-footer__inner {
      padding: 48px 24px 36px;
    }

    .cgs-footer__top {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .cgs-footer__cols {
      justify-content: start;
      gap: 40px;
    }
  }

  @media (max-width: 560px) {
    .cgs-footer__inner {
      padding: 40px 20px 32px;
    }

    .cgs-footer__form {
      flex-direction: column;
    }

    .cgs-footer__submit {
      width: 100%;
    }

    .cgs-footer__cols {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
  }
</style>
