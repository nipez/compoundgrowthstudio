---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GlpPage from '../../components/cms/GlpPage.astro';
import { pages } from '../../lib/site';
import { fetchDocument, pageIds, type GlpDoc } from '../../lib/sanity';

const cms = await fetchDocument<GlpDoc>(pageIds.glp);
const page = {
  ...pages['glp-1-peptide-marketing'],
  title: cms?.seo?.title || pages['glp-1-peptide-marketing'].title,
  description: cms?.seo?.description || pages['glp-1-peptide-marketing'].description,
};
---

<BaseLayout page={page}>
  <GlpPage doc={cms} />
</BaseLayout>
