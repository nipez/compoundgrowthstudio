---
import BaseLayout from '../../layouts/BaseLayout.astro';

const page = {
  path: '/admin/',
  title: 'Submissions | Compound Growth Studio',
  description: 'Internal log of contact requests, guide downloads, and newsletter signups.',
  noindex: true,
};
---

<BaseLayout page={page}>
  <section class="admin cgs-pad">
    <header class="admin__head">
      <div>
        <div class="admin__eyebrow">Internal</div>
        <h1 class="admin__title">Form submissions</h1>
        <p class="admin__sub">Contact requests, guide downloads, newsletter signups, and calculator captures.</p>
      </div>
      <div class="admin__account" id="admin-panel" hidden>
        <span class="admin__user" id="admin-user"></span>
        <button type="button" class="admin__ghost" id="admin-signout">Sign out</button>
      </div>
    </header>

    <div class="admin__login" id="admin-login" hidden>
      <form class="admin__form" id="admin-login-form">
        <h2 class="admin__form-title">Sign in</h2>
        <p class="admin__form-note">Use the Supabase user created for the studio team.</p>
        <label class="admin__label">
          Email
          <input class="admin__input" name="email" type="email" autocomplete="username" required />
        </label>
        <label class="admin__label">
          Password
          <input class="admin__input" name="password" type="password" autocomplete="current-password" required />
        </label>
        <button type="submit" class="admin__btn">Sign in</button>
      </form>
    </div>

    <div class="admin__body" id="admin-panel-body" hidden>
      <div class="admin__toolbar">
        <div class="admin__tabs">
          <button type="button" class="admin__tab" data-admin-tab="contact" data-active="true">Contact requests</button>
          <button type="button" class="admin__tab" data-admin-tab="leads">Guide &amp; newsletter</button>
        </div>
        <div class="admin__tools">
          <input class="admin__input admin__input--search" id="admin-search" type="search" placeholder="Search email, clinic, message…" />
          <button type="button" class="admin__ghost" id="admin-refresh">Refresh</button>
          <button type="button" class="admin__ghost" id="admin-export">Export CSV</button>
        </div>
      </div>

      <div class="admin__meta">
        <span id="admin-count"></span>
        <span class="admin__status" id="admin-status"></span>
      </div>

      <div id="admin-table-body"></div>
    </div>
  </section>

  <script>
    import '../../scripts/admin.ts';
  </script>
</BaseLayout>

<style>
  .admin {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--cgs-content-max, 1280px);
    margin: 0 auto;
    padding: 56px 48px 96px;
  }

  .admin__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 32px;
  }

  .admin__eyebrow {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #1a4fd0;
  }

  .admin__title {
    margin: 12px 0 0;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
    font-size: 34px;
    letter-spacing: -1.2px;
    color: #0a1d38;
  }

  .admin__sub {
    margin: 10px 0 0;
    font-size: 15.5px;
    color: rgba(10, 29, 56, 0.68);
  }

  .admin__account {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 14px;
    color: rgba(10, 29, 56, 0.7);
  }

  .admin__form {
    display: grid;
    gap: 14px;
    max-width: 380px;
    padding: 30px 28px;
    background: #ffffff;
    border: 1px solid rgba(10, 29, 56, 0.1);
    border-radius: 4px;
  }

  .admin__form-title {
    margin: 0;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
    font-size: 20px;
    color: #0a1d38;
  }

  .admin__form-note {
    margin: -4px 0 0;
    font-size: 13.5px;
    color: rgba(10, 29, 56, 0.6);
  }

  .admin__label {
    display: grid;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: rgba(10, 29, 56, 0.7);
  }

  .admin__input {
    padding: 12px 14px;
    font-family: 'Archivo', sans-serif;
    font-size: 15px;
    color: #0a1d38;
    background: #f4f7fb;
    border: 1px solid rgba(10, 29, 56, 0.18);
    border-radius: 3px;
    outline: none;
  }

  .admin__input--search {
    min-width: 260px;
    background: #ffffff;
  }

  .admin__btn {
    padding: 13px 0;
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-size: 15px;
    color: #ffffff;
    background: #1a4fd0;
    border: none;
    border-radius: 3px;
    cursor: pointer;
  }

  .admin__ghost {
    padding: 10px 16px;
    font-family: 'Archivo', sans-serif;
    font-weight: 600;
    font-size: 14px;
    color: #0a1d38;
    background: #ffffff;
    border: 1px solid rgba(10, 29, 56, 0.16);
    border-radius: 3px;
    cursor: pointer;
  }

  .admin__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .admin__tabs {
    display: flex;
    gap: 8px;
  }

  .admin__tab {
    padding: 10px 18px;
    font-family: 'Archivo', sans-serif;
    font-weight: 600;
    font-size: 14.5px;
    color: rgba(10, 29, 56, 0.7);
    background: #ffffff;
    border: 1px solid rgba(10, 29, 56, 0.14);
    border-radius: 3px;
    cursor: pointer;
  }

  .admin__tab[data-active='true'] {
    color: #ffffff;
    background: #0a1d38;
    border-color: #0a1d38;
  }

  .admin__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .admin__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin: 18px 0 14px;
    font-size: 13.5px;
    color: rgba(10, 29, 56, 0.6);
  }

  .admin__status[data-tone='error'] {
    color: #b42318;
    font-weight: 600;
  }

  :global(.admin-table) {
    width: 100%;
    border-collapse: collapse;
    background: #ffffff;
    border: 1px solid rgba(10, 29, 56, 0.1);
    border-radius: 4px;
    font-size: 14px;
  }

  :global(.admin-table th) {
    padding: 12px 14px;
    text-align: left;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(10, 29, 56, 0.55);
    background: #f4f7fb;
    border-bottom: 1px solid rgba(10, 29, 56, 0.1);
  }

  :global(.admin-table td) {
    padding: 14px;
    vertical-align: top;
    color: rgba(10, 29, 56, 0.82);
    border-bottom: 1px solid rgba(10, 29, 56, 0.07);
  }

  :global(.admin-table tr:last-child td) {
    border-bottom: none;
  }

  :global(.admin-nowrap) {
    white-space: nowrap;
  }

  :global(.admin-dim) {
    color: rgba(10, 29, 56, 0.5);
    font-size: 13px;
  }

  :global(.admin-message) {
    max-width: 420px;
    white-space: pre-wrap;
  }

  :global(.admin-tag) {
    display: inline-block;
    padding: 3px 9px;
    font-size: 12px;
    font-weight: 600;
    color: #1a4fd0;
    background: #e7eefa;
    border-radius: 999px;
  }

  :global(.admin-empty) {
    margin: 0;
    padding: 40px 0;
    color: rgba(10, 29, 56, 0.55);
  }

  @media (max-width: 720px) {
    .admin__toolbar {
      align-items: stretch;
    }

    .admin__input--search {
      min-width: 0;
      width: 100%;
    }

    #admin-table-body {
      overflow-x: auto;
    }
  }
</style>
