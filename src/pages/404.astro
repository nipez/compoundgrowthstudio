---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pages } from '../lib/site';

const page = {
  path: '/404/',
  title: 'Page not found | Compound Growth Studio',
  description: pages.home.description,
};
---

<BaseLayout page={page}>
  <header style="background: #0A1D38; color: #F4F7FB; padding: 120px 48px; text-align: center;">
    <h1 style="margin: 0; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 48px; letter-spacing: -1.6px;">Page not found</h1>
    <p style="margin: 18px auto 0; max-width: 480px; color: rgba(244,247,251,.74); font-size: 17px; line-height: 1.6;">
      That page doesn’t exist. Head back home or book a growth call.
    </p>
    <div style="margin-top: 32px; display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
      <a href="/" style="display: inline-block; padding: 14px 22px; background: #1A4FD0; color: #FFFFFF; font-weight: 700; border-radius: 3px;">Home</a>
      <a href="/contact/" style="display: inline-block; padding: 14px 22px; border: 1.5px solid rgba(244,247,251,.4); color: #F4F7FB; font-weight: 600; border-radius: 3px;">Contact</a>
    </div>
  </header>
</BaseLayout>
