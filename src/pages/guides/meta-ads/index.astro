---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { metaAdsGuide } from '../../../content/guides/meta-ads-top-10';

const page = {
  path: '/guides/meta-ads/',
  title: `${metaAdsGuide.title} | Compound Growth Studio`,
  description: metaAdsGuide.subtitle,
};

const thanks = Astro.url.searchParams.get('thanks') === '1';
---

<BaseLayout page={page}>
  <article class="guide">
    <header class="guide__hero">
      <div class="guide__hero-grid" aria-hidden="true"></div>
      <div class="guide__hero-inner">
        {
          thanks && (
            <div class="guide__thanks">
              You’re in — here’s your guide. Bookmark this page or use Print → Save as PDF.
            </div>
          )
        }
        <div class="guide__eyebrow">{metaAdsGuide.eyebrow}</div>
        <h1 class="guide__title">{metaAdsGuide.title}</h1>
        <p class="guide__subtitle">{metaAdsGuide.subtitle}</p>
        <p class="guide__intro">{metaAdsGuide.intro}</p>
        <p class="guide__audience">{metaAdsGuide.audienceNote}</p>
        <div class="guide__actions">
          <button type="button" class="guide__print" data-guide-print>Print / Save as PDF</button>
          <a class="guide__cta-secondary" href="/contact/">Book a growth gap call →</a>
        </div>
      </div>
    </header>

    <section class="guide__list">
      {
        metaAdsGuide.reasons.map((reason) => (
          <div class="guide__reason">
            <div class="guide__num">{reason.number}</div>
            <div class="guide__reason-body">
              <h2>{reason.title}</h2>
              <div class="guide__block">
                <div class="guide__label">What’s going wrong</div>
                <p>{reason.problem}</p>
              </div>
              <div class="guide__block">
                <div class="guide__label">Why it stalls growth</div>
                <p>{reason.why}</p>
              </div>
              <div class="guide__block guide__block--fix">
                <div class="guide__label">Fix this first</div>
                <p>{reason.fix}</p>
              </div>
            </div>
          </div>
        ))
      }
    </section>

    <section class="guide__close">
      <h2>{metaAdsGuide.closingTitle}</h2>
      <p>{metaAdsGuide.closingBody}</p>
      <a class="guide__cta" href={metaAdsGuide.ctaHref}>{metaAdsGuide.ctaLabel}</a>
      <p class="guide__cta-note">{metaAdsGuide.ctaNote}</p>
    </section>
  </article>
</BaseLayout>

<style>
  .guide {
    --ink: #0a1d38;
    --paper: #f4f7fb;
    --blue: #1a4fd0;
    --sky: #7fb0ff;
    --panel: #e7eefa;
    color: var(--ink);
    background: var(--paper);
  }

  .guide__hero {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: var(--paper);
  }

  .guide__hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(127, 176, 255, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(127, 176, 255, 0.07) 1px, transparent 1px);
    background-size: 56px 56px;
  }

  .guide__hero-inner {
    position: relative;
    max-width: 820px;
    margin: 0 auto;
    padding: 72px 48px 64px;
  }

  .guide__thanks {
    margin-bottom: 22px;
    padding: 12px 16px;
    border: 1px solid rgba(127, 176, 255, 0.45);
    border-radius: 3px;
    background: rgba(26, 79, 208, 0.28);
    color: #dce9ff;
    font-size: 14.5px;
    font-weight: 600;
  }

  .guide__eyebrow {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sky);
  }

  .guide__title {
    margin: 18px 0 0;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
    font-size: clamp(34px, 5vw, 48px);
    line-height: 1.08;
    letter-spacing: -1.6px;
    text-wrap: pretty;
  }

  .guide__subtitle {
    margin: 20px 0 0;
    font-size: 18px;
    line-height: 1.55;
    color: rgba(244, 247, 251, 0.78);
  }

  .guide__intro,
  .guide__audience {
    margin: 18px 0 0;
    font-size: 16px;
    line-height: 1.65;
    color: rgba(244, 247, 251, 0.72);
  }

  .guide__audience {
    padding-top: 14px;
    border-top: 1px solid rgba(244, 247, 251, 0.12);
    font-size: 14.5px;
    color: rgba(244, 247, 251, 0.58);
  }

  .guide__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 22px;
    align-items: center;
    margin-top: 28px;
  }

  .guide__print,
  .guide__cta {
    display: inline-block;
    padding: 14px 22px;
    border: none;
    border-radius: 3px;
    background: var(--blue);
    color: #fff;
    font-family: 'Archivo', sans-serif;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
  }

  .guide__cta-secondary {
    color: var(--paper);
    font-weight: 600;
    font-size: 15px;
    border-bottom: 1px solid rgba(244, 247, 251, 0.4);
    padding-bottom: 2px;
  }

  .guide__list {
    max-width: 820px;
    margin: 0 auto;
    padding: 56px 48px 24px;
    display: grid;
    gap: 18px;
  }

  .guide__reason {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 22px;
    padding: 28px 28px 26px;
    background: #fff;
    border: 1px solid rgba(10, 29, 56, 0.1);
    border-radius: 4px;
  }

  .guide__num {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
    font-size: 28px;
    letter-spacing: -1px;
    color: var(--blue);
    line-height: 1;
  }

  .guide__reason-body h2 {
    margin: 0 0 16px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
    font-size: 24px;
    letter-spacing: -0.7px;
    line-height: 1.2;
  }

  .guide__block + .guide__block {
    margin-top: 14px;
  }

  .guide__label {
    margin-bottom: 4px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(10, 29, 56, 0.45);
  }

  .guide__block p {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.62;
    color: rgba(10, 29, 56, 0.78);
  }

  .guide__block--fix {
    padding: 14px 16px;
    border-radius: 3px;
    background: var(--panel);
  }

  .guide__block--fix .guide__label {
    color: var(--blue);
  }

  .guide__close {
    max-width: 820px;
    margin: 20px auto 96px;
    padding: 40px 44px;
    background: var(--ink);
    color: var(--paper);
    border-radius: 4px;
  }

  .guide__close h2 {
    margin: 0;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
    font-size: 30px;
    letter-spacing: -1px;
  }

  .guide__close p {
    margin: 14px 0 0;
    font-size: 16px;
    line-height: 1.65;
    color: rgba(244, 247, 251, 0.74);
  }

  .guide__cta {
    margin-top: 26px;
  }

  .guide__cta-note {
    margin-top: 12px !important;
    font-size: 13.5px !important;
    color: rgba(244, 247, 251, 0.55) !important;
  }

  @media (max-width: 720px) {
    .guide__hero-inner,
    .guide__list {
      padding-left: var(--cgs-pad-x, 20px);
      padding-right: var(--cgs-pad-x, 20px);
    }

    .guide__title {
      font-size: clamp(2rem, 8vw, 3rem);
      letter-spacing: -0.04em;
    }

    .guide__reason {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 22px;
    }

    .guide__close {
      margin-left: var(--cgs-pad-x, 20px);
      margin-right: var(--cgs-pad-x, 20px);
      padding: 28px 24px;
    }

    .guide__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }

  @media print {
    :global(nav),
    :global(footer),
    .guide__actions,
    .guide__thanks {
      display: none !important;
    }

    .guide__hero {
      background: #fff !important;
      color: #0a1d38 !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .guide__eyebrow,
    .guide__subtitle,
    .guide__intro,
    .guide__audience {
      color: #0a1d38 !important;
    }

    .guide__reason {
      break-inside: avoid;
      box-shadow: none;
    }

    .guide__close {
      break-inside: avoid;
      background: #e7eefa !important;
      color: #0a1d38 !important;
    }

    .guide__close p,
    .guide__cta-note {
      color: rgba(10, 29, 56, 0.75) !important;
    }

    .guide__cta {
      display: none;
    }
  }
</style>

<script>
  document.querySelector('[data-guide-print]')?.addEventListener('click', () => window.print());
</script>
