---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pages } from '../../lib/site';
import { fetchDocument, pageIds, type FaqDoc } from '../../lib/sanity';
import fallbackHtml from '../../content/partials/faq.html?raw';

const cms = await fetchDocument<FaqDoc>(pageIds.faq);
const page = {
  ...pages.faq,
  title: cms?.seo?.title || pages.faq.title,
  description: cms?.seo?.description || pages.faq.description,
};

const faqs = cms?.faqs?.filter((f) => f.question && f.answer) ?? [];
const useCms = faqs.length > 0;
---

<BaseLayout page={page}>
  {
    useCms ? (
      <div>
        <header style="background: #0A1D38; color: #F4F7FB; position: relative; overflow: hidden;">
          <div style="position: absolute; inset: 0; background-image: linear-gradient(rgba(127,176,255,.07) 1px, transparent 1px), linear-gradient(90deg, rgba(127,176,255,.07) 1px, transparent 1px); background-size: 56px 56px;" />
          <div style="position: relative; max-width: 1280px; margin: 0 auto; padding: 84px 48px 76px;">
            <div style="font-size: 12.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #7FB0FF; animation: rise .6s both;">
              {cms?.eyebrow || 'FAQ'}
            </div>
            <h1 style="margin: 18px 0 0; max-width: 820px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 52px; line-height: 1.06; letter-spacing: -2px; animation: rise .7s .1s both;">
              {cms?.headline || 'Questions clinics ask before they start.'}
            </h1>
          </div>
        </header>
        <section style="max-width: 940px; margin: 0 auto; padding: 76px 48px 100px;">
          <div style="display: grid; gap: 12px;">
            {
              faqs.map((f) => (
                <details style="background: #FFFFFF; border: 1px solid rgba(10,29,56,.1); border-radius: 4px; animation: rise .7s both;">
                  <summary style="display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 24px 28px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; font-size: 18px; letter-spacing: -.4px; color: #0A1D38;">
                    {f.question}
                    <span style="flex-shrink: 0; color: #1A4FD0; font-size: 22px; font-weight: 500;">+</span>
                  </summary>
                  <p style="margin: 0; padding: 0 28px 26px; max-width: 760px; font-size: 15.5px; line-height: 1.68; color: rgba(10,29,56,.72);">
                    {f.answer}
                  </p>
                </details>
              ))
            }
          </div>
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 40px; margin-top: 56px; padding: 40px 44px; background: #E7EEFA; border-radius: 4px;">
            <div>
              <h2 style="margin: 0 0 8px; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 28px; letter-spacing: -1.1px;">
                Still deciding?
              </h2>
              <p style="margin: 0; font-size: 15.5px; line-height: 1.6; color: rgba(10,29,56,.72);">
                Book a growth gap call — we’ll map the clearest next step for your clinic.
              </p>
            </div>
            <a
              href="/contact/"
              class="cgs-h48"
              style="flex-shrink: 0; display: inline-block; padding: 16px 26px; background: #1A4FD0; color: #FFFFFF; font-weight: 700; font-size: 15px; border-radius: 3px; transition: transform .2s;"
            >
              Find Your Growth Gaps
            </a>
          </div>
        </section>
      </div>
    ) : (
      <Fragment set:html={fallbackHtml} />
    )
  }
</BaseLayout>
