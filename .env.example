# CRM lead intake endpoint. Marketing forms POST submissions here, so no
# database credentials ship in the static browser bundle.
# See docs/crm-lead-intake.md for the request/response contract.
CRM_LEADS_ENDPOINT=https://crm.compoundgrowthstudio.com/api/leads

# Optional alias (same value):
# PUBLIC_CRM_LEADS_ENDPOINT=

# Sanity CMS (project already created: CGS Marketing Website)
SANITY_PROJECT_ID=4rag8303
SANITY_DATASET=production
PUBLIC_SANITY_PROJECT_ID=4rag8303
PUBLIC_SANITY_DATASET=production

# Write token for seeding / CLI only — never commit. Needs Editor or Admin role.
# SANITY_AUTH_TOKEN=
