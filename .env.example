# Supabase project URL and anon (public) key.
# Used at build time and baked into the static client bundle.
# Safe to expose in the browser — RLS allows insert-only for anon.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional aliases (same values):
# PUBLIC_SUPABASE_URL=
# PUBLIC_SUPABASE_ANON_KEY=

# Sanity CMS (project already created: CGS Marketing Website)
SANITY_PROJECT_ID=4rag8303
SANITY_DATASET=production
PUBLIC_SANITY_PROJECT_ID=4rag8303
PUBLIC_SANITY_DATASET=production

# Write token for seeding / CLI only — never commit. Needs Editor or Admin role.
# SANITY_AUTH_TOKEN=
