# Where marketing form submissions are POSTed. Simplest option is a Google
# Apps Script web app writing to a Sheet — see docs/google-sheet-setup.md.
# Can also point at the CRM route (docs/crm-lead-intake.md).
FORM_ENDPOINT=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Optional alias (same value):
# PUBLIC_FORM_ENDPOINT=

# Sanity CMS (project already created: CGS Marketing Website)
SANITY_PROJECT_ID=4rag8303
SANITY_DATASET=production
PUBLIC_SANITY_PROJECT_ID=4rag8303
PUBLIC_SANITY_DATASET=production

# Write token for seeding / CLI only — never commit. Needs Editor or Admin role.
# SANITY_AUTH_TOKEN=
