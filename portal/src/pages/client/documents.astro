---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { gateUser } from '../../lib/auth';
import { demoDocuments } from '../../lib/demo-data';
import { CLIENT_NAV } from '../../lib/modules';
import { getSessionUser } from '../../lib/supabase';

const user = await getSessionUser(Astro.request, Astro.cookies);
const gate = gateUser(user, 'client');
if (gate) return Astro.redirect(gate);
if (!user) return Astro.redirect('/login/');
---

<PortalLayout title="Documents" user={user} nav={CLIENT_NAV} portalLabel="Client portal">
  <header class="page-head">
    <div>
      <p class="eyebrow">Vault</p>
      <h1>Documents</h1>
      <p class="lede">Contracts, brand kits, and compliance packs — stored in Supabase Storage.</p>
    </div>
  </header>

  <section class="panel">
    <table class="table">
      <thead>
        <tr>
          <th>Document</th>
          <th>Category</th>
          <th>Updated</th>
        </tr>
      </thead>
      <tbody>
        {
          demoDocuments.map((doc) => (
            <tr>
              <td>
                <strong>{doc.title}</strong>
              </td>
              <td>{doc.category}</td>
              <td>{doc.updated}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>
</PortalLayout>
