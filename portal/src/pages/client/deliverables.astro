---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { gateUser } from '../../lib/auth';
import { demoDeliverables } from '../../lib/demo-data';
import { CLIENT_NAV } from '../../lib/modules';
import { getSessionUser } from '../../lib/supabase';

const user = await getSessionUser(Astro.request, Astro.cookies);
const gate = gateUser(user, 'client');
if (gate) return Astro.redirect(gate);
if (!user) return Astro.redirect('/login/');
---

<PortalLayout title="Deliverables" user={user} nav={CLIENT_NAV} portalLabel="Client portal">
  <header class="page-head">
    <div>
      <p class="eyebrow">Work product</p>
      <h1>Deliverables & reports</h1>
      <p class="lede">Monthly reporting, landing pages, and campaign packages shared by CGS.</p>
    </div>
  </header>

  <section class="panel">
    <table class="table">
      <thead>
        <tr>
          <th>Deliverable</th>
          <th>Type</th>
          <th>Period</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {
          demoDeliverables.map((d) => (
            <tr>
              <td>
                <strong>{d.title}</strong>
              </td>
              <td>{d.kind.replace('_', ' ')}</td>
              <td>{d.period}</td>
              <td>
                <span class={`pill ${d.status === 'shared' ? 'pill-ok' : 'pill-blue'}`}>{d.status}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>
</PortalLayout>
