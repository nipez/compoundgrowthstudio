---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { requireUser } from '../../lib/auth';
import { demoClients, demoInvoices } from '../../lib/demo-data';
import { CGS_NAV } from '../../lib/modules';
import { getSessionUser } from '../../lib/supabase';

const user = await getSessionUser(Astro.request, Astro.cookies);
requireUser(user, 'cgs_staff');
---

<PortalLayout title="Billing" user={user} nav={CGS_NAV} portalLabel="CGS ops">
  <header class="page-head">
    <div>
      <p class="eyebrow">Revenue</p>
      <h1>Billing overview</h1>
      <p class="lede">
        Stripe is source of truth. Portal caches invoices and subscription status for ops visibility.
      </p>
    </div>
  </header>

  <div class="grid grid-3">
    <div class="panel stat">
      <div class="label">Retainer MRR (demo)</div>
      <div class="value">$2,100</div>
    </div>
    <div class="panel stat">
      <div class="label">Open invoices</div>
      <div class="value">1</div>
    </div>
    <div class="panel stat">
      <div class="label">Past due</div>
      <div class="value">0</div>
    </div>
  </div>

  <div class="grid grid-2" style="margin-top:16px;">
    <section class="panel">
      <h2>By client</h2>
      <table class="table">
        <thead>
          <tr>
            <th>Clinic</th>
            <th>Plan</th>
            <th>MRR</th>
          </tr>
        </thead>
        <tbody>
          {
            demoClients.map((c) => (
              <tr>
                <td>{c.name}</td>
                <td>{c.plan}</td>
                <td>{c.mrr}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>
    <section class="panel">
      <h2>Recent invoices</h2>
      <table class="table">
        <thead>
          <tr>
            <th>Invoice</th>
            <th>Amount</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {
            demoInvoices.map((inv) => (
              <tr>
                <td>{inv.number}</td>
                <td>${(inv.amountCents / 100).toLocaleString()}</td>
                <td>
                  <span class={`pill ${inv.status === 'paid' ? 'pill-ok' : 'pill-warn'}`}>{inv.status}</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>
  </div>
</PortalLayout>
